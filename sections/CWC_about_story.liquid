{% style %}
  #cwc_about-story-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --eyebrow-color: {{ section.settings.eyebrow_color | default: '#3F8060' }};
    --heading-color: {{ section.settings.heading_color | default: '#0C3B2C' }};
    --highlight-color: {{ section.settings.bold_color | default: '#3F8060' }};
    --subtext-color: {{ section.settings.subtext_color | default: '#0C3B2C' }};
    --text-color: {{ section.settings.text_color | default: '#0C3B2C' }};
    --callout-bg: {{ section.settings.callout_bg | default: '#D0F0F2' }};
    --callout-text-color: {{ section.settings.callout_text_color | default: '#0C3B2C' }};
    --callout-radius: {{ section.settings.card_radius | default: 14 }}px;
    --icon-bg: {{ section.settings.icon_bg | default: '#125657' }};
    --icon-color: {{ section.settings.icon_color | default: '#ffffff' }};
    --image-radius: {{ section.settings.image_radius | default: 14 }}px;
    --heading-font: var(--g-font-1, inherit);
    --body-font: var(--g-font-2, inherit);
    --content-width: {{ section.settings.content_max_width | default: 760 }}px;
    --padding-top: {{ section.settings.padding_top | default: 80 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 80 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 80 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_about_story.css' | asset_url | stylesheet_tag }}

<section id="cwc_about-story-{{ section.id }}" class="cwc_about-story">
  <div class="cwc_about-story__container">

    {% comment %} Section Header {% endcomment %}
    {% if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subtext != blank %}
      <div class="cwc_about-story__content">
        {% if section.settings.eyebrow != blank %}
          <span class="cwc_about-story__content-eyebrow">{{ section.settings.eyebrow }}</span>
        {% endif %}

        {% if section.settings.heading != blank %}
          <div class="cwc_about-story__content-heading cwc-rte">
            {{ section.settings.heading }}
          </div>
        {% endif %}

        {% if section.settings.subtext != blank %}
          <div class="cwc_about-story__content-subtext cwc-rte">
            {{ section.settings.subtext }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    {% comment %} Optional Image + Story Body {% endcomment %}
    <div class="cwc_about-story__wrapper cwc_about-story__wrapper--media-{{ section.settings.media_position | default: 'top' }}">

      {% if section.settings.image != blank %}
        <div class="cwc_about-story__image">
          <img
            src="{{ section.settings.image | image_url: width: 1200 }}"
            srcset="
              {{ section.settings.image | image_url: width: 600 }} 600w,
              {{ section.settings.image | image_url: width: 900 }} 900w,
              {{ section.settings.image | image_url: width: 1200 }} 1200w
            "
            sizes="(max-width: 768px) 100vw, 50vw"
            alt="{{ section.settings.image_alt | default: section.settings.image.alt | escape }}"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            loading="lazy"
          >
        </div>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="cwc_about-story__body">
          {% for block in section.blocks %}
            {% case block.type %}

              {% when 'paragraph' %}
                {% if block.settings.text != blank %}
                  <div class="cwc_about-story__text cwc-rte" {{ block.shopify_attributes }}>
                    {{ block.settings.text }}
                  </div>
                {% endif %}

              {% when 'callout' %}
                {% if block.settings.text != blank %}
                  <div class="cwc_about-story__callout" {{ block.shopify_attributes }}>
                    {% if block.settings.show_icon %}
                      <span class="cwc_about-story__callout-icon">
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.75"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                          focusable="false"
                        >
                          <path d="M12 2.75 4.75 5.6v5.6c0 4.4 2.95 8.5 7.25 10.05 4.3-1.55 7.25-5.65 7.25-10.05V5.6Z"></path>
                          <path d="m9.25 12.1 1.95 1.95 3.55-3.9"></path>
                        </svg>
                      </span>
                    {% endif %}
                    <div class="cwc_about-story__callout-text cwc-rte">
                      {{ block.settings.text }}
                    </div>
                  </div>
                {% endif %}

            {% endcase %}
          {% endfor %}
        </div>
      {% else %}
        <div class="cwc_about-story__placeholder">
          <p>Add paragraph or callout blocks to tell your story.</p>
        </div>
      {% endif %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "CWC About Story",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (optional)",
      "default": "OUR STORY"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Section Heading",
      "default": "<h2>One formula. Done <strong>properly</strong>.</h2>"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Section Subtext (optional)"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#3F8060"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#0C3B2C"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Heading Bold Color",
      "default": "#3F8060"
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Subtext Color",
      "default": "#0C3B2C"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body Text Color",
      "default": "#0C3B2C"
    },
    {
      "type": "header",
      "content": "Callout Colors"
    },
    {
      "type": "color",
      "id": "callout_bg",
      "label": "Callout Background Color",
      "default": "#D0F0F2"
    },
    {
      "type": "color",
      "id": "callout_text_color",
      "label": "Callout Text Color",
      "default": "#0C3B2C"
    },
    {
      "type": "color",
      "id": "icon_bg",
      "label": "Icon Background Color",
      "default": "#125657"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Text Max Width",
      "min": 520,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 760,
      "info": "Reading width of the story text. Ignored when the image sits beside the text."
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Image Position",
      "options": [
        { "value": "top", "label": "Above text" },
        { "value": "left", "label": "Left of text" },
        { "value": "right", "label": "Right of text" }
      ],
      "default": "top"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Callout Corner Radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (optional)"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image Alt Text",
      "info": "Falls back to the alt text set on the image in Shopify."
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image Corner Radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "paragraph",
      "name": "Paragraph",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Simply Revival started with a simple frustration: the options for thinning hair were either harsh, complicated, or full of ingredients nobody could pronounce.</p>"
        }
      ]
    },
    {
      "type": "callout",
      "name": "Callout",
      "settings": [
        {
          "type": "checkbox",
          "id": "show_icon",
          "label": "Show icon",
          "default": true
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Every order is backed by our <strong>365-day money-back guarantee</strong>.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Story",
      "category": "CWC Custom",
      "blocks": [
        { "type": "paragraph" },
        { "type": "paragraph" },
        { "type": "paragraph" },
        { "type": "callout" }
      ]
    }
  ]
}
{% endschema %}
