    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background",
      "default": "#fffee3"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#3F8060"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#0C3B2C"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Highlight (bold) color",
      "default": "#3F8060"
    },
    {
      "type": "color",
      "id": "image_placeholder_bg",
      "label": "Image placeholder background",
      "default": "#E5E2D2"
    },
    {
      "type": "header",
      "content": "Item Colors"
    },
    {
      "type": "color",
      "id": "item_bg",
      "label": "Item background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "item_border",
      "label": "Item border",
      "default": "#E1E0D2"
    },
    {
      "type": "color",
      "id": "item_border_hover",
      "label": "Item border (hover/active)",
      "default": "#C9C8B6"
    },
    {
      "type": "color",
      "id": "item_question_color",
      "label": "Question text color",
      "default": "#0C3B2C"
    },
    {
      "type": "color",
      "id": "item_answer_color",
      "label": "Answer text color",
      "default": "#2A3A33"
    },
    {
      "type": "color",
      "id": "item_chevron_color",
      "label": "Chevron color",
      "default": "#3F8060"
    },
    {
      "type": "color",
      "id": "item_answer_divider",
      "label": "Answer divider line",
      "default": "#EAE8DA"
    },
    {
      "type": "header",
      "content": "Badge Colors"
