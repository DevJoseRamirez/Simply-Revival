{% style %}
  #cwc_key-facts-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#FAF9F6' }};
    --text-color: {{ section.settings.text_color | default: '#111111' }};
    --highlight-color: {{ section.settings.bold_color | default: '#125657' }};
    --subtext-color: {{ section.settings.subtext_color | default: '#6B7280' }};
    --number-color: {{ section.settings.number_color | default: '#125657' }};
    --fact-title-color: {{ section.settings.fact_title_color | default: '#111111' }};
    --fact-text-color: {{ section.settings.fact_text_color | default: '#6B7280' }};
    --heading-font: var({{ section.settings.heading_font | default: '--g-font-1' }}, inherit);
    --number-font: var({{ section.settings.number_font | default: '--g-font-2' }}, inherit);
    --body-font: var(--g-font-2, inherit);
    --content-width: {{ section.settings.content_max_width | default: 820 }}px;
    --column-gap: {{ section.settings.column_gap | default: 80 }}px;
    --row-gap: {{ section.settings.row_gap | default: 40 }}px;
    --padding-top: {{ section.settings.padding_top | default: 60 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 60 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 60 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_key_facts.css' | asset_url | stylesheet_tag }}

<section id="cwc_key-facts-{{ section.id }}" class="cwc_key-facts">
  {% comment %} Desktop Background Image {% endcomment %}
  {% if section.settings.bg_image_desktop != blank %}
    <div
      class="cwc_key-facts__bg-desktop"
      style="background-image: url('{{ section.settings.bg_image_desktop | image_url }}');"
    ></div>
  {% endif %}

  {% comment %} Mobile Background Image (falls back to desktop) {% endcomment %}
  {% if section.settings.bg_image_mobile != blank %}
    <div
      class="cwc_key-facts__bg-mobile"
      style="background-image: url('{{ section.settings.bg_image_mobile | image_url }}');"
    ></div>
  {% elsif section.settings.bg_image_desktop != blank %}
    <div
      class="cwc_key-facts__bg-mobile"
      style="background-image: url('{{ section.settings.bg_image_desktop | image_url }}');"
    ></div>
  {% endif %}

  <div class="cwc_key-facts__container">
    <div class="cwc_key-facts__wrapper">

      {% comment %} Section Header {% endcomment %}
      <div class="cwc_key-facts__content">
        {% if section.settings.heading != blank %}
          <div class="cwc_key-facts__content-heading cwc-rte">
            {{ section.settings.heading }}
          </div>
        {% endif %}

        {% if section.settings.subtext != blank %}
          <div class="cwc_key-facts__content-subtext cwc-rte">
            {{ section.settings.subtext }}
          </div>
        {% endif %}
      </div>

      {% comment %} Fact Grid {% endcomment %}
      {% if section.blocks.size > 0 %}
        <div class="cwc_key-facts__grid">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'fact' %}
                <div class="cwc_key-facts__item" {{ block.shopify_attributes }}>
                  {% if block.settings.number != blank %}
                    <div class="cwc_key-facts__number">
                      {{ block.settings.number }}
                    </div>
                  {% endif %}

                  {% if block.settings.title != blank %}
                    <div class="cwc_key-facts__title cwc-rte">
                      {{ block.settings.title }}
                    </div>
                  {% endif %}

                  {% if block.settings.text != blank %}
                    <div class="cwc_key-facts__desc cwc-rte">
                      {{ block.settings.text }}
                    </div>
                  {% endif %}
                </div>
            {% endcase %}
          {% endfor %}
        </div>
      {% else %}
        <div class="cwc_key-facts__empty">
          <p>Add fact blocks to display content.</p>
        </div>
      {% endif %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "CWC Key Facts",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Section Heading",
      "default": "<p>What's <strong>Inside</strong> Every Capsule</p>"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Section Subtext",
      "default": "<p>Ten plant-based ingredients, full doses, nothing hidden behind a label.</p>"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading Font",
      "options": [
        { "value": "--g-font-1", "label": "Theme Heading Font" },
        { "value": "--g-font-2", "label": "Theme Body Font" }
      ],
      "default": "--g-font-1",
      "info": "Theme heading font matches the surrounding CWC sections."
    },
    {
      "type": "select",
      "id": "number_font",
      "label": "Fact Number Font",
      "options": [
        { "value": "--g-font-2", "label": "Theme Body Font" },
        { "value": "--g-font-1", "label": "Theme Heading Font" }
      ],
      "default": "--g-font-2",
      "info": "Body font matches the stat numbers in CWC Statistical Proof."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAF9F6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Heading Bold Color",
      "default": "#125657"
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Subtext Color",
      "default": "#6B7280"
    },
    {
      "type": "header",
      "content": "Fact Colors"
    },
    {
      "type": "color",
      "id": "number_color",
      "label": "Number Color",
      "default": "#125657"
    },
    {
      "type": "color",
      "id": "fact_title_color",
      "label": "Fact Title Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "fact_text_color",
      "label": "Fact Text Color",
      "default": "#6B7280"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content Max Width",
      "min": 600,
      "max": 1300,
      "step": 20,
      "unit": "px",
      "default": 820,
      "info": "Width of the heading and fact grid inside the section."
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column Gap",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Row Gap",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Background Image"
    },
    {
      "type": "image_picker",
      "id": "bg_image_desktop",
      "label": "Background Image (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image (Mobile)",
      "info": "Falls back to the desktop image if left empty."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "350mg+",
          "info": "Static value, e.g. 350mg+, 10, 2, 0"
        },
        {
          "type": "richtext",
          "id": "title",
          "label": "Title",
          "default": "<p>Proprietary herbal blend per serving</p>"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Including saw palmetto and stinging nettle</p>"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Key Facts",
      "category": "CWC Custom",
      "blocks": [
        { "type": "fact" },
        { "type": "fact" },
        { "type": "fact" },
        { "type": "fact" }
      ]
    }
  ]
}
{% endschema %}
