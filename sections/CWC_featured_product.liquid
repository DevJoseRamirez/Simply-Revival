{% style %}
  #CWC_featured_product-{{ section.id }} {
    --section-bg: {{ section.settings.background_color }};
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
    --padding-top-mobile: {{ section.settings.padding_top | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_featured_product.css' | asset_url | stylesheet_tag }}
{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}

{% comment %}
  Product Context Logic:
  1. If section settings has a product selected, use that (allows override)
  2. Else if template context has product (e.g., product page), use that
  3. Else no product available
{% endcomment %}
{% liquid
  if section.settings.product != blank
    assign current_product = section.settings.product
  elsif product != blank
    assign current_product = product
  else
    assign current_product = null
  endif
%}

{% if current_product %}
  <div id="cwc-featured-product--anchor"></div>
  <section
    id="CWC_featured_product-{{ section.id }}"
    class="cwc-featured-product"
    data-section-id="{{ section.id }}"
    data-product-id="{{ current_product.id }}"
    data-variants="{{ current_product.variants | json | escape }}"
    data-selling-plans="{{ current_product.selling_plan_groups | json | escape }}"
    data-savings-display="{{ section.settings.savings_display_type }}"
  >
    <div class="cwc-featured-product__wrapper">
      <div class="cwc-featured-product__grid">
        <!-- Left Column -->
        <div class="cwc-featured-product__left">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'product_image' %}
                <div class="cwc-featured-product__image" {{ block.shopify_attributes }}>
                  {% render 'CWC_product_image', product: current_product, section_id: section.id, block: block %}
                </div>

              {% when 'image_carousel' %}
                <div class="cwc-featured-product__image_carousel" {{ block.shopify_attributes }}>
                  {% render 'CWC_product_image_carousel',
                    product: current_product,
                    section_id: section.id,
                    block: block
                  %}
                </div>

            
              {% when 'faq' %}
                <div class="cwc-featured-product__faq desktop__only" {{ block.shopify_attributes }}>
                  {% render 'CWC_faq_blocks', product: current_product, section_id: section.id, block: block %}
                </div>

              {% when 'value_props' %}
                <div class="cwc-featured-product__value_props desktop__only" {{ block.shopify_attributes }}>
                  {% render 'CWC_block__value_props', product: current_product, section_id: section.id, block: block %}
                </div>

              {% when 'video_testimonials' %}
                {% if block.settings.column == 'left' %}
                  <div class="cwc-featured-product__video-testimonials" {{ block.shopify_attributes }}>
                    {% render 'CWC_video_testimonials_block', block: block, section_id: section.id %}
                  </div>
                {% endif %}
            {% endcase %}
          {% endfor %}
        </div>

        <!-- Right Column -->
        <div class="cwc-featured-product__right">
          {% comment %}
            Default Variant Selection:
            Use 2nd variant (index 1) as default if available,
            otherwise fall back to selected_or_first_available_variant
          {% endcomment %}
          {%- liquid
            if current_product.variants.size > 1 and current_product.variants[1].available
              assign default_variant = current_product.variants[1]
            else
              assign default_variant = current_product.selected_or_first_available_variant
            endif
          -%}

          <form
            action="/cart/add"
            method="post"
            enctype="multipart/form-data"
            class="cwc-featured-product__form"
            id="product-form-{{ section.id }}"
          >
            <input
              type="hidden"
              name="id"
              value="{{ default_variant.id }}"
              class="variant-id-input"
            >
            <input
              type="hidden"
              value=""
              name="selling_plan"
              class="selling-plan-input"
            >

            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'rating' %}
                  <div class="cwc-featured-product__rating" {{ block.shopify_attributes }}>
                    {% render 'CWC_prod_rating', product: current_product, section_id: section.id, block: block %}
                  </div>

                {% when 'vendor' %}
                  <div class="cwc-featured-product__vendor" {{ block.shopify_attributes }}>
                    {% if block.settings.vendor != blank %}
                      {{ block.settings.vendor }}
                    {% else %}
                      {{ current_product.vendor }}
                    {% endif %}
                  </div>

                {% when 'title' %}
                  {% style %}
                    #block-{{ block.id }} {
                      --text-color: {{ block.settings.text_color | default: '#282828' }};
                      --highlight-color: {{ block.settings.highlight_color | default: '#1E6C7A' }};
                    }
                  {% endstyle %}
                  <div id="block-{{ block.id }}" class="cwc-featured-product__title" {{ block.shopify_attributes }}>
                    {% if block.settings.title != blank %}
                      {{ block.settings.title }}
                    {% else %}
                      {{ current_product.title }}
                    {% endif %}
                  </div>
                  {% style %}
                    .cwc-featured-product__title > * {
                      background: linear-gradient(
                        90deg,
                        var(--text-color, #282828) 0%,
                        var(--highlight-color, #45b5b7) 45%,
                        var(--text-color, #282828)
                      );
                      background: linear-gradient(90deg, #2d2d2d 0%, #45b5b7 52.4%, #2d2d2d 100%);
                      -webkit-background-clip: text;
                      -webkit-text-fill-color: transparent;
                      background-clip: text;
                      margin: 0;
                      -webkit-background-clip: text;
                      -webkit-text-fill-color: transparent;
                      background-clip: text;
                      font-weight: inherit;
                      font-weight: bold;
                      width: max-content;
                    }
                  {% endstyle %}

                {% when 'desc' %}
                  <div class="cwc-featured-product__desc" {{ block.shopify_attributes }}>
                    {% if block.settings.desc != blank %}
                      {{ block.settings.desc }}
                    {% else %}
                      {{ current_product.description }}
                    {% endif %}
                  </div>

                {% when 'text' %}
                  <div class="cwc-featured-product__text" {{ block.shopify_attributes }}>
                    {{ block.settings.content }}
                  </div>

                {% when 'benefits' %}
                  <div class="cwc-featured-product__benefits" {{ block.shopify_attributes }}>
                    {% render 'CWC_benefits', product: current_product, section_id: section.id, block: block %}
                  </div>

                {% when 'price_display' %}
                  <div class="cwc-featured-product__price" {{ block.shopify_attributes }}>
                    {% render 'CWC_price_display',
                      product: current_product,
                      section_id: section.id,
                      block: block,
                      default_variant: default_variant
                    %}
                  </div>

                {% comment %}
                  Rendered from either column loop; the two guards are mutually
                  exclusive so the block never renders twice.
                {% endcomment %}
                {% when 'video_testimonials' %}
                  {% unless block.settings.column == 'left' %}
                    <div class="cwc-featured-product__video-testimonials" {{ block.shopify_attributes }}>
                      {% render 'CWC_video_testimonials_block', block: block, section_id: section.id %}
                    </div>
                  {% endunless %}

                {% when 'warning_notice' %}
                  <div class="cwc-featured-product__warning-notice" {{ block.shopify_attributes }}>
                    {% render 'CWC_warning_notice', block: block %}
                  </div>

                {% when 'low_stock' %}
                  <div class="cwc-featured-product__low-stock" {{ block.shopify_attributes }}>
                    {% render 'CWC_low_stock', block: block, product: current_product %}
                  </div>

                {% when 'trusted_by' %}
                  <div class="cwc-featured-product__trusted-by" {{ block.shopify_attributes }}>
                    {% render 'CWC_trusted_by', block: block %}
                  </div>

                {% when 'product_options' %}
                  {% if current_product.variants.size > 1 %}
                    <div
                      id="CWC_featured-product__options-{{ block.id }}"
                      class="cwc-featured-product__options"
                      {{ block.shopify_attributes }}
                    >
                      {% render 'CWC_product_options',
                        product: current_product,
                        section_id: section.id,
                        block: block,
                        default_variant: default_variant
                      %}
                    </div>
                  {% endif %}

                {% comment %}
                  =====================================================
                  PRODUCT OPTIONS · GIFT-UNLOCK TIERS
                  =====================================================
                  Additive alternative to the `product_options` block
                  above — never both in the same template. Renders the
                  tier buy box plus the "GIFTS UNLOCKED" reveal strip.

                  The buttons keep the classes and data attributes that
                  CWC_featured_product__core.js binds to, so variant
                  switching and per-tier cart add-ons need no JS changes.

                  SUBSCRIPTION-ONLY LAYOUT
                  ------------------------
                  This layout has no subscription toggle and no one-time
                  purchase path — everything is a subscription. But core.js
                  gates the selling plan on that toggle's checkbox:
                  isSubscriptionActive() reads #auto-refill-{section.id},
                  and if the element is missing it returns false, which
                  drops `selling_plan` from the cart payload AND makes
                  ui.js repaint one-time prices over the subscription
                  ones. So the checkbox is rendered here, hidden and
                  permanently checked. Everything downstream then behaves
                  exactly as it does today with the toggle switched on.

                  Don't also add a `subscription_toggle` block alongside
                  this one — two elements would share the same id and the
                  visible toggle would be the one core.js ignores.
                {% endcomment %}
                {% when 'product_options_tiers' %}
                  <input
                    type="checkbox"
                    id="auto-refill-{{ section.id }}"
                    checked
                    hidden
                    aria-hidden="true"
                    tabindex="-1"
                    style="display: none;"
                  >
                  {% if current_product.variants.size > 1 %}
                    <div
                      id="CWC_featured-product__gift-tiers-{{ block.id }}"
                      class="cwc-featured-product__gift_tiers"
                      {{ block.shopify_attributes }}
                    >
                      {% render 'CWC_product_options_tiers',
                        product: current_product,
                        section_id: section.id,
                        block: block,
                        default_variant: default_variant
                      %}
                    </div>
                  {% endif %}

                {% when 'subscription_toggle' %}
                  {% if current_product.selling_plan_groups.size > 0 %}
                    <div class="cwc-featured-product__subscription" {{ block.shopify_attributes }}>
                      {% render 'CWC_product_selling_plans',
                        product: current_product,
                        section_id: section.id,
                        block: block
                      %}
                    </div>
                  {% endif %}

                {% when 'delivery_estimate' %}
                  <div class="cwc-featured-product__delivery" {{ block.shopify_attributes }}>
                    {% render 'CWC_delivery_estimate', product: current_product, section_id: section.id, block: block %}
                  </div>

                {% when 'add_to_cart' %}
                  <div class="cwc-featured-product__add_to_cart" {{ block.shopify_attributes }}>
                    {% render 'CWC_add_to_cart', product: current_product, section_id: section.id, block: block %}
                  </div>

                {% comment %}
                  Tier-styled Add to Cart. Additive sibling of the block
                  above — same JS bindings, different presentation. Use one
                  or the other in a template, never both: they would emit
                  duplicate #add-to-cart-{section.id} ids.
                {% endcomment %}
                {% when 'add_to_cart_tiers' %}
                  <div class="cwc-featured-product__add_to_cart" {{ block.shopify_attributes }}>
                    {% render 'CWC_add_to_cart_tiers',
                      product: current_product,
                      section_id: section.id,
                      block: block
                    %}
                  </div>

                {% when 'guarantee_text' %}
                  <div class="cwc-featured-product__guarantee_text" {{ block.shopify_attributes }}>
                    {% render 'CWC_guarantee_text', product: current_product, section_id: section.id, block: block %}
                  </div>

                {% when 'faq' %}
                  <div class="cwc-featured-product__faq mobile__only" {{ block.shopify_attributes }}>
                    {% render 'CWC_faq_blocks', product: current_product, section_id: section.id, block: block %}
                  </div>

                {% when 'value_props' %}
                  <div class="cwc-featured-product__value_props mobile__only" {{ block.shopify_attributes }}>
                    {% render 'CWC_block__value_props',
                      product: current_product,
                      section_id: section.id,
                      block: block
                    %}
                  </div>
              {% endcase %}
            {% endfor %}
          </form>

          {{ 'CWC_featured_product__core.js' | asset_url | script_tag }}
          {{ 'CWC_featured_product__ui.js' | asset_url | script_tag }}
        </div>
      </div>
    </div>
  </section>
{% else %}
  {% comment %} No product available - show placeholder in editor {% endcomment %}
  {% if request.design_mode %}
    <section id="CWC_featured_product-{{ section.id }}" class="cwc-featured-product">
      <div class="cwc-featured-product__wrapper">
        <div style="padding: 2rem; text-align: center; background: #f5f5f5; border: 2px dashed #ccc; border-radius: 8px;">
          <p style="margin: 0; color: #666;">
            <strong>CWC Featured Product</strong><br>
            Select a product in section settings, or use this section on a product page template.
          </p>
        </div>
      </div>
    </section>
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "CWC Featured Product",
  "tag": "section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Optional: Leave blank to use product from page context (e.g., on product pages)"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#fff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "default": 60,
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "default": 60,
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "savings_display_type",
      "label": "Savings Display Type",
      "options": [
        {
          "value": "dollar",
          "label": "Show Dollar Amount"
        },
        {
