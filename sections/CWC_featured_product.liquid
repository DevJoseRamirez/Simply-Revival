{% style %}
  #CWC_featured_product-{{ section.id }} {
    --section-bg: {{ section.settings.background_color }};
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
    --padding-top-mobile: {{ section.settings.padding_top | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_featured_product.css' | asset_url | stylesheet_tag }}

{% if section.settings.product != blank %}
  {% assign product = section.settings.product %}
{% endif %}

<section
  id="CWC_featured_product-{{ section.id }}"
  class="cwc-featured-product"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-variants="{{ product.variants | json | escape }}"
  data-selling-plans="{{ product.selling_plan_groups | json | escape }}"
>
  <div class="cwc-featured-product__wrapper">
    <div class="cwc-featured-product__grid">
      <!-- Left Column -->
      <div class="cwc-featured-product__left">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'product_image' %}
              {% if block.settings.image != blank %}
                <div class="cwc-featured-product__image" {{ block.shopify_attributes }}>
                  <img
                    src="{{ block.settings.image | image_url: width: 600 }}"
                    alt="{{ block.settings.image.alt }}"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                  >
                </div>
              {% else %}
                <div class="cwc-featured-product__image" {{ block.shopify_attributes }}>
                  <img
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    alt="{{ product.featured_image.alt }}"
                    width="{{ product.featured_image.width }}"
                    height="{{ product.featured_image.height }}"
                  >
                </div>
              {% endif %}
            {% when 'faq' %}
              <div class="cwc-featured-product__faq" {{ block.shopify_attributes }}>
                {% render 'CWC_faqs', product: product, section_id: section.id, block: block %}
              </div>
          {% endcase %}
        {% endfor %}
      </div>

      <!-- Right Column -->
      <div class="cwc-featured-product__right">
        {% assign product = section.settings.product %}
        {% if product %}
          <form
            action="/cart/add"
            method="post"
            enctype="multipart/form-data"
            class="cwc-featured-product__form"
            id="product-form-{{ section.id }}"
          >
            <input
              type="hidden"
              name="id"
              value="{{ product.selected_or_first_available_variant.id }}"
              class="variant-id-input"
            >
            <input
              type="hidden"
              value=""
              name="selling_plan"
              class="selling-plan-input"
            >

            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'rating' %}
                  <div class="cwc-featured-product__rating" {{ block.shopify_attributes }}>
                    {{ block.settings.text }}
                  </div>
                {% when 'text' %}
                  <div class="cwc-featured-product__text" {{ block.shopify_attributes }}>
                    {{ block.settings.content }}
                  </div>
                {% when 'benefits' %}
                  <div class="cwc-featured-product__benefits" {{ block.shopify_attributes }}>
                    {% render 'CWC_benefits', product: product, section_id: section.id, block: block %}
                  </div>

                {% when 'price_display' %}
                  <div class="cwc-featured-product__price" {{ block.shopify_attributes }}>
                    {% render 'CWC_price_display', product: product, section_id: section.id, block: block %}
                  </div>

                {% when 'product_options' %}
                  {% if product.variants.size > 1 %}
                    <div class="cwc-featured-product__options" {{ block.shopify_attributes }}>
                      {% render 'CWC_product_options', product: product, section_id: section.id, block: block %}
                    </div>
                  {% endif %}

                {% when 'subscription_toggle' %}
                  {% if product.selling_plan_groups.size > 0 %}
                    {% render 'CWC_product_selling_plans', product: product, section_id: section.id, block: block %}
                  {% endif %}

                {% when 'delivery_estimate' %}
                  <div class="cwc-featured-product__delivery" {{ block.shopify_attributes }}>
                    {% render 'CWC_delivery_estimate', product: product, section_id: section.id, block: block %}

                    {% if block.settings.icon != blank %}
                      <img src="{{ block.settings.icon | image_url: width: 24 }}" alt="{{ block.settings.icon.alt }}">
                    {% endif %}
                    <span>{{ block.settings.text }}</span>
                  </div>

                {% when 'add_to_cart' %}
                  <div class="cwc-featured-product__add_to_cart" {{ block.shopify_attributes }}>
                    {% render 'CWC_add_to_cart', product: product, section_id: section.id, block: block %}
                  </div>
              {% endcase %}
            {% endfor %}
          </form>

          {{ 'CWC_featured_product.js' | asset_url | script_tag }}
        {% endif %}
      </div>
    </div>
  </div>
</section>

