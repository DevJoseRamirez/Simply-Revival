{% comment %}
    {% if product_id %}
      {{ 'https://areviewsapp.com/css/reviews_online.css' | stylesheet_tag }}
      <div id="az_reviews" class="az_reviews AReviewsApp" data-nosnippet data-product_id="{{ product_id }}"></div>
      <script src="https://areviewsapp.com/js_codes/areviews_app.js"></script>

      <script>
  (function () {
    // ---- CONFIG ----
    // Phrases that should nuke a whole review card:
    const HARD_BLOCK = [
      /hair\s*loss/i,w
      /\bregrow(th)?\b/i,
      /\bbald(ness)?\b/i,
      /\bmale\s*pattern\b/i,
      /\balopecia\b/i,
      /\bhormonal\b/i,
      /\b(cure|treat(ment)?)\b/i,
      /\bDHT\b/i,
      /\b(block(er|ing)?\s*DHT)\b/i
    ];

    // Softer terms we'll redact (in reviews that survive the hard check):
    const REDACT_ONLY = [
      { re: /\bDHT\b/gi, repl: '—' },
      { re: /\bregrow(th)?\b/gi, repl: 'improve' },
      { re: /hair\s*loss/gi, repl: 'shedding' },
      { re: /\btreat(ment)?\b/gi, repl: 'support' },
      { re: /\balopecia\b/gi, repl: '—' },
      { re: /\bhormonal\b/gi, repl: '—' }
    ];

    // ---- HELPERS ----
    const containerSel = '#list.areviews_load_more_container';
    const itemSel      = `${containerSel} .item`;           // each review card
    const commentSel   = '.comment';                         // text body inside card

    function stripInjectedSchema() {
      document.querySelectorAll('script[type="application/ld+json"]').forEach(s => {
        try {
          const j = JSON.parse(s.textContent || '{}');
          const isReview = j['@type'] === 'Review';
          const isProductWithReviews = j['@type'] === 'Product' && (j.review || j.aggregateRating);
          if (isReview || isProductWithReviews) s.remove();
        } catch (e) { /* ignore */ }
      });
    }

    function containsHardBlock(text) {
      return HARD_BLOCK.some(re => re.test(text));
    }

    function redactNodeText(node) {
      // Walk only text nodes to avoid breaking markup
      const walker = document.createTreeWalker(node, NodeFilter.SHOW_TEXT, null, false);
      const edits = [];
      while (walker.nextNode()) {
        const original = walker.currentNode.nodeValue;
        let updated = original;
        REDACT_ONLY.forEach(({re, repl}) => { updated = updated.replace(re, repl); });
        if (updated !== original) edits.push({ n: walker.currentNode, v: updated });
      }
      edits.forEach(({n, v}) => { n.nodeValue = v; });
    }

    function sanitizeOnce(root=document) {
      const items = root.querySelectorAll(itemSel);
      items.forEach(card => {
        const comment = card.querySelector(commentSel);
        const text = (comment?.textContent || card.textContent || '').trim();
        if (!text) return;

        if (containsHardBlock(text)) {
          card.remove(); // entire review removed
        } else if (comment) {
          redactNodeText(comment); // softer substitutions in place
        }
      });

      // Remove any JSON-LD that might carry risky terms
      stripInjectedSchema();
    }

    // Run after initial render and on lazy-loaded inserts
    function boot() {
      sanitizeOnce();

      const container = document.querySelector(containerSel);
      if (!container) return;

      // Keep sanitizing as Areviews appends more nodes
      const mo = new MutationObserver(muts => {
        let needs = false;
        for (const m of muts) {
          if (m.addedNodes && m.addedNodes.length) { needs = true; break; }
        }
        if (needs) sanitizeOnce(container);
      });
      mo.observe(container, { childList: true, subtree: true });
    }

    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      setTimeout(boot, 800); // allow Areviews to mount
    } else {
      window.addEventListener('DOMContentLoaded', () => setTimeout(boot, 800));
    }
  })();
  </script>

    {% endif %}
{% endcomment %}

{% schema %}
{
  "name": "CWC Areviews Wdget",
  "tag": "section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product Selection"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "default": 60,
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "default": 60,
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Areviews Wdget",
      "category": "custom"
    }
  ]
}
{% endschema %}

