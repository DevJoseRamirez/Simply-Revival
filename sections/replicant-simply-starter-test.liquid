{%- comment -%} ═════════════ SWIPER (self-contained CDN, one init fn) ═════════════ {%- endcomment -%}
<script
  defer
  src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"
  onload="replicantSimplyStarterTestInit()"
  onerror="var r=document.getElementById('replicant-simply-starter-test'); if(r) r.classList.add('rp-noswiper');"
></script>
<script>
  function replicantSimplyStarterTestInit() {
    var root = document.getElementById('replicant-simply-starter-test');
    if (!root || window.__rpSSTdone) return;
    if (typeof Swiper === 'undefined') {
      root.classList.add('rp-noswiper');
      return;
    }
    window.__rpSSTdone = true;
    root.classList.remove('rp-noswiper');

    // ---- Gallery (main + thumbs) ----
    try {
      var main = document.getElementById('rp-gmain');
      var thumbsWrap = document.getElementById('rp-gthumbs');
      var thumbSwiper = null;
      if (thumbsWrap) {
        var thumbEl = thumbsWrap.querySelector('.swiper');
        if (thumbEl)
          thumbSwiper = new Swiper(thumbEl, {
            slidesPerView: 5,
            spaceBetween: 4,
            watchSlidesProgress: true,
            slideToClickedSlide: true,
          });
      }
      if (main) {
        var mainSwiper = new Swiper(main, {
          loop: false,
          spaceBetween: 4,
          speed: 400,
          keyboard: { enabled: true },
          navigation: {
            nextEl: '#replicant-simply-starter-test-gallery .g-main .swiper-button-next',
            prevEl: '#replicant-simply-starter-test-gallery .g-main .swiper-button-prev',
          },
          thumbs: thumbSwiper ? { swiper: thumbSwiper } : undefined,
          on: {
            slideChange: function () {
              if (!thumbsWrap) return;
              var items = thumbsWrap.querySelectorAll('.g-thumb');
              var idx = this.realIndex;
              items.forEach(function (t, i) {
                t.classList.toggle('active', i === idx);
              });
            },
          },
        });
        if (thumbsWrap)
          thumbsWrap.querySelectorAll('.g-thumb').forEach(function (t, i) {
            t.addEventListener('click', function () {
              mainSwiper.slideTo(i);
            });
          });
      }
    } catch (e) {}

    // ---- Hero testimonial carousel ----
    try {
      new Swiper('#rp-quotes', {
        slidesPerView: 1,
        spaceBetween: 12,
        loop: true,
        speed: 500,
        autoplay: { delay: 4000, disableOnInteraction: false },
      });
    } catch (e) {}

    // ---- Card carousels (transformations / experts / ugc / advisory) ----
    function cc(id, opts) {
      try {
        var sel = '#' + id;
        var barSel = sel + '-bar';
        new Swiper(
          sel,
          Object.assign(
            {
              slidesPerView: 1.1,
              spaceBetween: 16,
              speed: 400,
              navigation: { nextEl: sel + '-next', prevEl: sel + '-prev' },
              breakpoints: { 768: { slidesPerView: 2 }, 1024: { slidesPerView: opts.desk || 3 } },
              on: {
                slideChange: function () {
                  var bar = document.querySelector(barSel);
                  if (bar)
                    bar.style.width =
                      ((this.activeIndex + 1) /
                        Math.max(1, this.slides.length - Math.floor(this.params.slidesPerView) + 1)) *
                        100 +
                      '%';
                },
              },
            },
            opts.extra || {}
          )
        );
      } catch (e) {}
    }
    // 4a: image carousel — smooth continuous infinite marquee; pauses only on interaction
    try {
      new Swiper('#rp-transimg', {
        slidesPerView: 'auto',
        spaceBetween: 16,
        loop: true,
        loopedSlides: 6,
        speed: 6000,
        grabCursor: true,
        allowTouchMove: true,
        autoplay: { delay: 0, disableOnInteraction: false, pauseOnMouseEnter: true, waitForTransition: false },
      });
    } catch (e) {}
    // 4b: text testimonials — manual swipe + arrows only (no autoplay)
    cc('rp-transtxt', { desk: 3 });
    cc('rp-experts', { desk: 3 });
    cc('rp-ugc', {
      desk: 5,
      extra: {
        breakpoints: {
          0: { slidesPerView: 1.3, spaceBetween: 8 },
          480: { slidesPerView: 2.1 },
          768: { slidesPerView: 3 },
          1024: { slidesPerView: 5, spaceBetween: 20 },
        },
      },
    });
    cc('rp-advisory', { desk: 3 });

    // ---- Ingredients: static grid always (no carousel) ----
  }

  // ---- Tabs (day + week) ----
  (function () {
    document.querySelectorAll('#replicant-simply-starter-test [data-tabs]').forEach(function (root) {
      var btns = root.querySelectorAll('.tab-btn');
      var panels = root.querySelectorAll('.tab-panel');
      btns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var i = btn.getAttribute('data-tab');
          btns.forEach(function (b) {
            b.setAttribute('aria-selected', b === btn ? 'true' : 'false');
          });
          panels.forEach(function (pnl) {
            pnl.classList.toggle('is-active', pnl.getAttribute('data-panel') === i);
          });
        });
      });
    });
  })();

  // ---- Image modal (supplement facts) ----
  (function () {
    var scope = document.getElementById('replicant-simply-starter-test');
    if (!scope) return;
    function close(m) {
      m.classList.remove('is-open');
    }
    scope.querySelectorAll('[data-rp-modal-open]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var m = document.getElementById(btn.getAttribute('data-rp-modal-open'));
        if (m) m.classList.add('is-open');
      });
    });
    scope.querySelectorAll('[data-rp-modal-close]').forEach(function (el) {
      el.addEventListener('click', function () {
        var m = el.closest('.rp-modal');
        if (m) close(m);
      });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') scope.querySelectorAll('.rp-modal.is-open').forEach(close);
    });
  })();

  // ---- Offer toggle (visual only) ----
  (function () {
    var toggle = document.querySelectorAll('#replicant-simply-starter-test .offer-toggle button');
    toggle.forEach(function (b) {
      b.addEventListener('click', function () {
        toggle.forEach(function (x) {
          x.classList.remove('is-active');
        });
        b.classList.add('is-active');
      });
    });
  })();

  // ---- ATC (self-contained AJAX, static + sticky) ----
  (function () {
    var scope = document.getElementById('replicant-simply-starter-test');
    var sticky = document.getElementById('replicant-simply-starter-test-sticky');
    var staticBtn = document.getElementById('rp-atc');
    // Open this store's mini-cart drawer via its trigger. NEVER redirect anywhere.
    function openCartOrFallback() {
      try {
        document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
        document.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true }));
        document.dispatchEvent(new CustomEvent('cart-drawer:open', { bubbles: true }));
      } catch (e) {}
      var trigger = document.querySelector('.js-mini-cart');
      if (trigger) {
        trigger.click();
      }
    }
    function addToCart(btn) {
      var variantId = btn.getAttribute('data-variant-id');
      if (!variantId) {
        return;
      }
      if (btn.classList.contains('is-loading')) {
        return;
      } // guard: ignore re-entrant clicks
      var item = { id: Number(variantId), quantity: 1 };
      var sp = btn.getAttribute('data-selling-plan');
      if (sp) {
        item.selling_plan = Number(sp);
      } // add as subscription
      var items = [item];
      var addon = btn.getAttribute('data-addon-variant'); // extra product added with the main item
      if (addon) {
        items.push({ id: Number(addon), quantity: 1 });
      }
      btn.classList.add('is-loading');
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: items }),
      })
        .then(function (r) {
          return r.json();
        })
        .then(function () {
          btn.classList.remove('is-loading');
          openCartOrFallback();
        })
        .catch(function () {
          btn.classList.remove('is-loading');
          alert('Could not add to cart. Please try again.');
        });
    }
    [scope, sticky].forEach(function (c) {
      if (!c) return;
      c.querySelectorAll('.rp-atc-btn').forEach(function (btn) {
        if (btn.disabled || btn.dataset.rpBound) return; // guard: never bind the same button twice
        btn.dataset.rpBound = '1';
        btn.addEventListener('click', function () {
          addToCart(btn);
        });
      });
    });
    if (sticky && staticBtn) {
      var io = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              sticky.classList.remove('is-visible');
            } else {
              sticky.classList.toggle('is-visible', staticBtn.getBoundingClientRect().bottom < 0);
            }
          });
        },
        { threshold: 0 }
      );
      io.observe(staticBtn);
    }
  })();

  // ---- Swiper load safety net ----
  // If Swiper is already on the page (e.g. theme-provided) init right away; the onload handler
  // also calls init (double-init guarded). If after a few seconds Swiper still hasn't loaded
  // (CDN blocked by store CSP), fall back to a scrollable strip so nothing blows up.
  (function () {
    if (typeof Swiper !== 'undefined') {
      try {
        replicantSimplyStarterTestInit();
      } catch (e) {}
    }
    setTimeout(function () {
      var root = document.getElementById('replicant-simply-starter-test');
      if (!root) return;
      if (typeof Swiper !== 'undefined') {
        try {
          replicantSimplyStarterTestInit();
        } catch (e) {}
      } else {
        root.classList.add('rp-noswiper');
      }
    }, 3000);
  })();
</script>

