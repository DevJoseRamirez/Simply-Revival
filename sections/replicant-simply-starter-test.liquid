<style>
  #rp-id-util {
    font: 13px/1.5 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    background: #0e1a1a;
    color: #c9f0e6;
    border: 1px solid #1e3a3a;
    border-radius: 8px;
    padding: 14px 16px;
    margin: 0 0 16px;
    max-width: 900px;
  }
  #rp-id-util h4 {
    margin: 0 0 8px;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #72c9ca;
  }
  #rp-id-util .rp-row {
    padding: 2px 0;
    border-bottom: 1px solid #16292955;
  }
  #rp-id-util .rp-k {
    color: #8fb8b0;
  }
  #rp-id-util .rp-v {
    color: #ffe08a;
  }
  #rp-id-util table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 6px;
  }
  #rp-id-util th,
  #rp-id-util td {
    text-align: left;
    padding: 3px 8px 3px 0;
    border-bottom: 1px solid #16292955;
    vertical-align: top;
  }
  #rp-id-util th {
    color: #72c9ca;
    font-weight: 600;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
</style>
<div id="rp-id-util">
  <h4>Replicant · Selected Product Inspector</h4>
  {%- if p == blank -%}
    <div class="rp-row"><span class="rp-k">⚠ No product selected in this section's settings.</span></div>
  {%- else -%}
    <div class="rp-row">
      <span class="rp-k">Product:</span> <span class="rp-v">{{ p.title }}</span>
    </div>
    <div class="rp-row">
      <span class="rp-k">Product ID:</span> <span class="rp-v">{{ p.id }}</span>
    </div>
    <div class="rp-row">
      <span class="rp-k">Handle:</span> <span class="rp-v">{{ p.handle }}</span>
    </div>

    <h4 style="margin-top:14px">Options ({{ p.options_with_values.size }})</h4>
    <table>
      <thead>
        <tr>
          <th>Option</th>
          <th>Values</th>
        </tr>
      </thead>
      <tbody>
        {%- for opt in p.options_with_values -%}
          <tr>
            <td>{{ opt.name }}</td>
            <td class="rp-v">{{ opt.values | join: ', ' }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
    </table>

    <h4 style="margin-top:14px">Variants ({{ p.variants.size }})</h4>
    <table>
      <thead>
        <tr>
          <th>Variant ID</th>
          <th>Title</th>
          <th>Options</th>
          <th>Price</th>
          <th>Available</th>
        </tr>
      </thead>
      <tbody>
        {%- for variant in p.variants -%}
          <tr>
            <td class="rp-v">{{ variant.id }}</td>
            <td>{{ variant.title }}</td>
            <td>{{ variant.options | join: ' / ' }}</td>
            <td>{{ variant.price | money }}</td>
            <td>{{ variant.compare_at_price | money }}</td>
            <td>{{ variant.available }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
    </table>

    <h4 style="margin-top:14px">Selling plans</h4>
    {%- if p.selling_plan_groups.size > 0 -%}
      <table>
        <thead>
          <tr>
            <th>Group</th>
            <th>Selling Plan ID</th>
            <th>Plan name</th>
          </tr>
        </thead>
        <tbody>
          {%- for group in p.selling_plan_groups -%}
            {%- for plan in group.selling_plans -%}
              <tr>
                <td>{{ group.name }}</td>
                <td class="rp-v">{{ plan.id }}</td>
                <td>{{ plan.name }}</td>
              </tr>
            {%- endfor -%}
          {%- endfor -%}
        </tbody>
      </table>
    {%- else -%}
      <div class="rp-row"><span class="rp-k">No selling plan groups on this product.</span></div>
    {%- endif -%}
  {%- endif -%}
</div>
{% endcomment %}
{%- comment -%} ═══════════ END DEV UTILITY ═══════════ {%- endcomment -%}

