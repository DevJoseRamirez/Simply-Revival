{% style %}
#CWC_reasons-{{ section.id }} {
--section-bg: {{ section.settings.section_bg }};
--heading-color: {{ section.settings.heading_color }};
--text-color: {{ section.settings.text_color }};
--card-bg: {{ section.settings.card_bg }};
--card-text: {{ section.settings.card_text }};
--caption-bg: {{ section.settings.caption_bg }};
--caption-color: {{ section.settings.caption_color }};
--btn-bg: {{ section.settings.btn_bg }};
--btn-color: {{ section.settings.btn_color }};
}
{% endstyle %}


{{ 'CWC_reasons.css' | asset_url | stylesheet_tag }}

<section id="CWC_reasons-{{ section.id }}" class="cwc-reasons">
    <div class="cwc-reasons__wrapper">

        {% if section.settings.caption != blank %}
        <div class="cwc-reasons__caption">
            {{ section.settings.caption }}
        </div>
        {% endif %}

        {% if section.settings.heading != blank %}
        <h2 class="cwc-reasons__heading">
            {{ section.settings.heading }}
        </h2>
        {% endif %}

        {% if section.settings.text != blank %}
        <div class="cwc-reasons__text">
            {{ section.settings.text }}
        </div>
        {% endif %}

        <div class="cwc-reasons__grid">
            {% for block in section.blocks %}
            {% case block.type %}

            {% when 'reason' %}
            <div class="cwc-reasons__card">
                {% if block.settings.img != blank %}
                <div class="cwc-reasons__image">
                    <img src="{{ block.settings.img | img_url: '400x' }}" alt="{{ block.settings.title | escape }}">
                </div>
                {% endif %}
                {% if block.settings.badge != blank %}
                <div class="cwc-reasons__badge">{{ block.settings.badge }}</div>
                {% endif %}
                {% if block.settings.title != blank %}
                <h3 class="cwc-reasons__title">{{ block.settings.title }}</h3>
                {% endif %}
                {% if block.settings.text != blank %}
                <div class="cwc-reasons__desc">{{ block.settings.text }}</div>
                {% endif %}
            </div>

            {% when 'button' %}
            <div class="cwc-reasons__cta">
                {% if block.settings.text != blank %}
                <a href="{{ block.settings.link }}" class="cwc-reasons__btn">
                    {{ block.settings.text }}
                </a>
                {% endif %}
                {% if block.settings.note != blank %}
                <div class="cwc-reasons__note">{{ block.settings.note }}</div>
                {% endif %}
            </div>

            {% endcase %}
            {% endfor %}
        </div>

    </div>
</section>


