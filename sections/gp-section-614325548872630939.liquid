    letter-spacing: 0.5px;
  }
  .big-cta-btn:hover { background: #1b5e20; }

  /* ── PRODUCT BOTTOM CARD ── */
  .product-bottom-card {
    border: 1px solid #ccc;
    padding: 24px;
    margin: 32px 0;
    text-align: center;
  }
  .product-bottom-card .rec { font-family: Arial, sans-serif; font-size: 14px; color: #555; margin-bottom: 4px; }
  .product-bottom-card .pname { font-family: Arial, sans-serif; font-size: 22px; font-weight: bold; margin-bottom: 4px; }
  .product-bottom-card .stars { color: #f5a623; font-size: 20px; margin-bottom: 4px; }
  .product-bottom-card .rtext { font-family: Arial, sans-serif; font-size: 14px; color: #555; margin-bottom: 16px; }

  .product-bottom-card .trust-list {
    list-style: none;
    text-align: left;
    display: inline-block;
    margin-bottom: 20px;
  }
  .product-bottom-card .trust-list li {
    font-family: Arial, sans-serif;
    font-size: 15px;
    padding: 6px 0 6px 28px;
    position: relative;
    border-bottom: 1px solid #eee;
  }
  .product-bottom-card .trust-list li:last-child { border-bottom: none; }
  .product-bottom-card .trust-list li::before {
    content: '✔';
    position: absolute; left: 0;
    color: #2e7d32; font-size: 18px;
  }

  /* ── DISCLAIMER ── */
  .disclaimer {
    font-family: Arial, sans-serif;
    font-size: 12px;
    color: #888;
    line-height: 1.6;
    border-top: 1px solid #ddd;
    padding-top: 20px;
    margin-top: 40px;
  }
  .disclaimer p { margin-bottom: 8px; }

  /* ── RESPONSIVE ── */
  @media (max-width: 700px) {
    .page { flex-direction: column; }
    .sidebar { width: 100%; position: static; }
    .hero-grid { flex-direction: column; }
    .expert-photo { width: 100%; aspect-ratio: 4/3; }
    .guarantee-box { flex-direction: column; align-items: center; text-align: center; }
