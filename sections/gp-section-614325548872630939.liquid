  .ingredient {
    margin-bottom: 28px;
    padding-bottom: 28px;
    border-bottom: 1px solid #eee;
  }
  .ingredient:last-child { border-bottom: none; }
  .ingredient h3 {
    font-family: Arial, sans-serif;
    font-size: 20px;
    font-weight: bold;
    margin-bottom: 6px;
  }
  .ingredient-img {
    width: 100%;
    max-width: 300px;
    height: 160px;
    background: #f0f0f0;
    margin: 10px 0;
    display: flex; align-items: center; justify-content: center;
    font-family: Arial, sans-serif; font-size: 12px; color: #999;
    border: 1px dashed #ccc;
  }

  /* ── TESTIMONIAL ── */
  .testimonial {
    margin: 24px 0;
    padding: 0;
  }
  .testimonial h2 {
    font-family: Arial, sans-serif;
    font-size: clamp(20px, 3vw, 26px);
    font-weight: bold;
    text-align: center;
    margin-bottom: 16px;
  }
  .testimonial-img {
    width: 100%;
    max-width: 420px;
    height: 220px;
    background: #ddd;
