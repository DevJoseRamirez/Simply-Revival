    text-align: center;
    padding: 14px 10px;
    text-decoration: none;
    border-radius: 4px;
    cursor: pointer;
    border: none;
    width: 100%;
  }
  .cta-btn:hover { background: #1b5e20; }

  /* ── TOP HEADLINE (red) ── */
  .top-headline {
    font-family: Arial, sans-serif;
    font-size: clamp(18px, 3vw, 24px);
    font-weight: bold;
    color: #cc0000;
    text-align: center;
    margin-bottom: 16px;
    line-height: 1.3;
  }

  /* ── MAIN HEADLINE ── */
  .main-headline {
    font-family: Arial, sans-serif;
    font-size: clamp(22px, 4vw, 32px);
    font-weight: bold;
    color: #111;
    text-align: center;
    margin-bottom: 14px;
    line-height: 1.25;
  }
  .main-headline u { text-decoration: underline; }

  /* ── ITALIC SUBHEAD ── */
  .subhead {
    font-family: Georgia, serif;
    font-size: clamp(16px, 2.5vw, 20px);
    font-style: italic;
    color: #333;
    text-align: center;
    margin-bottom: 10px;
  }

  /* ── BYLINE ── */
  .byline {
    font-family: Arial, sans-serif;
    font-size: 13px;
    color: #777;
    margin-bottom: 20px;
  }

  /* ── HERO IMAGE GRID ── */
  .hero-grid {
    display: flex;
    gap: 12px;
    margin-bottom: 24px;
    align-items: flex-start;
  }

  .expert-photo {
