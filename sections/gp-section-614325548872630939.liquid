    gap: 8px;
  }

  .ba-wrap {
    position: relative;
  }

  .ba-img {
    width: 100%;
    aspect-ratio: 1;
    background: #ccc;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: Arial, sans-serif;
    font-size: 11px;
    color: #888;
    border: 1px dashed #bbb;
    /* REPLACE WITH ACTUAL BEFORE/AFTER PHOTOS */
  }

  .ba-label {
    position: absolute;
    bottom: 0;
    left: 0; right: 0;
    background: rgba(0,0,0,0.75);
    color: #fff;
    font-family: Arial, sans-serif;
    font-size: 16px;
    font-weight: bold;
    text-align: center;
    padding: 6px;
    letter-spacing: 1px;
  }

  /* ── BODY TEXT ── */
  .body-text {
    font-family: Georgia, serif;
    font-size: 18px;
    line-height: 1.75;
    color: #111;
    margin-bottom: 16px;
