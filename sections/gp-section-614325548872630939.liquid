    flex-shrink: 0;
    position: sticky;
    top: 16px;
  }

  .sidebar-box {
    border: 1px solid #ccc;
    padding: 16px;
    background: #fff;
    text-align: center;
  }

  .sidebar-box .rec-label {
    font-family: Arial, sans-serif;
    font-size: 20px;
    font-weight: bold;
    margin-bottom: 6px;
  }

  .sidebar-box .stars {
    color: #f5a623;
    font-size: 22px;
    letter-spacing: 2px;
    margin-bottom: 4px;
  }

  .sidebar-box .rating-text {
    font-family: Arial, sans-serif;
    font-size: 14px;
    color: #333;
    margin-bottom: 8px;
  }

  .sidebar-box .product-name {
    color: #2e7d32;
    font-family: Arial, sans-serif;
    font-size: 15px;
    font-weight: bold;
    margin-bottom: 12px;
  }

  .sidebar-box .check-list {
    list-style: none;
    text-align: left;
    margin-bottom: 14px;
  }

  .sidebar-box .check-list li {
    font-family: Arial, sans-serif;
    font-size: 13px;
    color: #333;
    padding: 5px 0 5px 28px;
    position: relative;
    border-bottom: 1px solid #eee;
    line-height: 1.4;
  }
  .sidebar-box .check-list li:last-child { border-bottom: none; }

  .sidebar-box .check-list li::before {
    content: '✔';
    position: absolute;
    left: 0;
    color: #2e7d32;
    font-size: 18px;
  }

  .sidebar-box .product-img {
    width: 100%;
    max-width: 180px;
    height: 140px;
    background: #f0f0f0;
    margin: 10px auto 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: Arial, sans-serif;
    font-size: 11px;
    color: #999;
    border: 1px dashed #ccc;
    /* REPLACE WITH: <img src="YOUR-PRODUCT-IMAGE.jpg" style="width:100%"> */
  }

  .cta-btn {
    display: block;
    background: #2e7d32;
    color: #fff;
    font-family: Arial, sans-serif;
    font-size: 15px;
