  /* ── YELLOW HIGHLIGHT ── */
  .yellow-highlight {
    display: inline;
    background: #ffe066;
    font-weight: bold;
    font-style: italic;
    padding: 2px 4px;
  }

  /* ── SECTION HEADING (centered, bold) ── */
  .section-heading {
    font-family: Arial, sans-serif;
    font-size: clamp(20px, 3.5vw, 28px);
    font-weight: bold;
    text-align: center;
    color: #111;
    margin: 32px 0 16px;
    line-height: 1.3;
  }
  .section-heading em { font-style: italic; }

  /* ── INLINE BEFORE/AFTER (single pair, centered) ── */
  .ba-pair {
    display: flex;
    gap: 0;
    max-width: 560px;
    margin: 20px auto 8px;
  }
  .ba-pair .ba-wrap { flex: 1; }
  .ba-pair .ba-img { aspect-ratio: 1; border-radius: 0; }

  .ba-labels-row {
    display: flex;
    max-width: 560px;
    margin: 0 auto 24px;
  }
  .ba-labels-row span {
    flex: 1;
    text-align: center;
    font-family: Arial, sans-serif;
    font-weight: bold;
    font-size: 16px;
    letter-spacing: 1px;
    padding-top: 6px;
  }

  /* ── QUOTE PARAGRAPHS ── */
  .quote-para {
    font-family: Georgia, serif;
    font-size: 18px;
    line-height: 1.75;
    color: #111;
    margin-bottom: 16px;
  }

