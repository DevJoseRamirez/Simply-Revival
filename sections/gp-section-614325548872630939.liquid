    display: flex; align-items: center; justify-content: center;
    font-family: Arial, sans-serif; font-size: 12px; color: #888;
    border: 1px dashed #bbb;
  }

  /* ── GUARANTEE ── */
  .guarantee-box {
    border: 2px solid #ccc;
    padding: 24px;
    margin: 32px 0;
    display: flex;
    gap: 20px;
    align-items: center;
    flex-wrap: wrap;
  }
  .guarantee-badge-img {
    width: 100px; height: 100px;
    border-radius: 50%;
    border: 3px solid #2e7d32;
    background: #f5f5f5;
    flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    flex-direction: column;
    text-align: center;
    padding: 8px;
  }
  .guarantee-badge-img .days {
    font-family: Arial, sans-serif;
    font-size: 26px;
    font-weight: bold;
    color: #2e7d32;
    line-height: 1;
  }
  .guarantee-badge-img .gtext {
    font-family: Arial, sans-serif;
    font-size: 9px;
    color: #333;
    text-transform: uppercase;
    line-height: 1.3;
    margin-top: 4px;
  }
  .guarantee-copy h3 {
    font-family: Arial, sans-serif;
    font-size: 20px;
    font-weight: bold;
    margin-bottom: 8px;
  }
  .guarantee-copy p {
    font-family: Georgia, serif;
    font-size: 16px;
    color: #333;
    line-height: 1.65;
  }

  /* ── BOTTOM CTA ── */
  .bottom-cta {
    text-align: center;
    margin: 32px 0;
  }
  .bottom-cta p {
    font-family: Georgia, serif;
