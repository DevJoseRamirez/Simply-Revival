{% style %}
  #CWC_bundle_product_template-{{ section.id }} {
    --section-bg: {{ section.settings.background_color }};
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
    --padding-top-mobile: {{ section.settings.padding_top | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_bundle_product_template.css' | asset_url | stylesheet_tag }}
{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}

{% if section.settings.product != blank %}
  {% assign product = section.settings.product %}
{% endif %}

<div id="cwc-bundle-product-template--anchor"></div>
<section
  id="CWC_bundle_product_template-{{ section.id }}"
  class="cwc-bundle-product-template"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-variants="{{ product.variants | json | escape }}"
  data-selling-plans="{{ product.selling_plan_groups | json | escape }}"
>
  <div class="cwc-bundle-product-template__wrapper">
    <div class="cwc-bundle-product-template__grid">
      <!-- Left Column -->
      <div class="cwc-bundle-product-template__left">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'product_image' %}
              <div class="cwc-bundle-product-template__image" {{ block.shopify_attributes }}>
                {% render 'CWC_product_image', product: product, section_id: section.id, block: block %}
              </div>

            {% when 'image_carousel' %}
              <div class="cwc-bundle-product-template__image_carousel" {{ block.shopify_attributes }}>
                {% render 'CWC_product_image_carousel', product: product, section_id: section.id, block: block %}
              </div>

            {% when 'faq' %}
              <div class="cwc-bundle-product-template__faq desktop__only" {{ block.shopify_attributes }}>
                {% render 'CWC_faq_blocks', product: product, section_id: section.id, block: block %}
              </div>
          {% endcase %}
        {% endfor %}
      </div>

      <!-- Right Column -->
      <div class="cwc-bundle-product-template__right">
        {% assign product = section.settings.product %}
        {% if product %}
          <form
            action="/cart/add"
            method="post"
            enctype="multipart/form-data"
            class="cwc-bundle-product-template__form"
            id="product-form-{{ section.id }}"
          >
            <input
              type="hidden"
              name="id"
              value="{{ product.selected_or_first_available_variant.id }}"
              class="variant-id-input"
            >
            <input
              type="hidden"
              value=""
              name="selling_plan"
              class="selling-plan-input"
            >

            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'rating' %}
                  <div class="cwc-bundle-product-template__rating" {{ block.shopify_attributes }}>
                    {% render 'CWC_prod_rating', product: product, section_id: section.id, block: block %}
                  </div>

                {% when 'vendor' %}
                  <div class="cwc-bundle-product-template__vendor" {{ block.shopify_attributes }}>
                    {% if block.settings.vendor != blank %}
                      {{ block.settings.vendor }}
                    {% else %}
                      {{ product.vendor }}
                    {% endif %}
                  </div>

                {% when 'bundle-content' %}
                  <div class="cwc-bundle-product-template__content" {{ block.shopify_attributes }}>
                    {% render 'CWC_bundle_content', product: product, section_id: section.id, block: block %}
                  </div>

                {% when 'refund' %}
                  <div class="cwc-bundle-product-template__refund" {{ block.shopify_attributes }}>
                    {% render 'CWC_refund_bar', product: product, section_id: section.id, block: block %}
                  </div>

                {% when 'review' %}
                  <div class="cwc-bundle-product-template__review" {{ block.shopify_attributes }}>
                    {% render 'CWC_review_block', product: product, section_id: section.id, block: block %}
                  </div>

                {% when 'refund-progress-bar' %}
                  <div class="cwc-bundle-product-template__refund-bar" {{ block.shopify_attributes }}>
                    {% render 'CWC_refund_bar', product: product, section_id: section.id, block: block %}
                  </div>

                {% when 'bullet-icon' %}
                  <div class="cwc-bundle-product-template__bullet-icon" {{ block.shopify_attributes }}>
                    {% render 'CWC_bullet-icon', product: product, section_id: section.id, block: block %}
                  </div>

                {% when 'disclaimer' %}
                  <div class="cwc-bundle-product-template__disclaimer" {{ block.shopify_attributes }}>
                    {{ block.settings.text }}
                  </div>

                {% when 'bundle_price_display' %}
                  <div class="cwc-bundle-product-template__price" {{ block.shopify_attributes }}>
                    {% render 'CWC_bundle_price_display', product: product, section_id: section.id, block: block %}
                  </div>

                {% when 'bundle-button' %}
                  <div class="cwc-bundle-product-template__button" {{ block.shopify_attributes }}>
                    {% render 'CWC_bundle_add_to_cart', product: product, section_id: section.id, block: block %}
                  </div>

                  {% comment %}  {% endcomment %}
                  {% comment %}  {% endcomment %}
                  {% comment %}  {% endcomment %}
                  {% comment %}  {% endcomment %}

                {% when 'title' %}
                  <div class="cwc-bundle-product-template__title" {{ block.shopify_attributes }}>
                    {{ block.settings.title }}
                  </div>

                {% when 'desc' %}
                  <div class="cwc-bundle-product-template__desc" {{ block.shopify_attributes }}>
                    {% if block.settings.desc != blank %}
                      {{ block.settings.desc }}
                    {% else %}
                      {{ product.description }}
                    {% endif %}
                  </div>

                {% when 'text' %}
                  <div class="cwc-bundle-product-template__text" {{ block.shopify_attributes }}>
                    {{ block.settings.content }}
                  </div>

                {% when 'benefits' %}
                  <div class="cwc-bundle-product-template__benefits" {{ block.shopify_attributes }}>
                    {% render 'CWC_benefits', product: product, section_id: section.id, block: block %}
                  </div>

                {% when 'price_display' %}
                  <div class="cwc-bundle-product-template__price" {{ block.shopify_attributes }}>
                    {% render 'CWC_price_display', product: product, section_id: section.id, block: block %}
                  </div>

                  {% comment %}
                    {% when 'product_options' %}
                      {% if product.variants.size > 1 %}
                        <div class="cwc-bundle-product-template__options" {{ block.shopify_attributes }}>
                          {% render 'CWC_product_options', product: product, section_id: section.id, block: block %}
                        </div>
                      {% endif %}
                  {% endcomment %}

                  {% comment %}
                    {% when 'subscription_toggle' %}
                      {% if product.selling_plan_groups.size > 0 %}
                        <div class="cwc-bundle-product-template__subscription" {{ block.shopify_attributes }}>
                          {% render 'CWC_product_selling_plans', product: product, section_id: section.id, block: block %}
                        </div>
                      {% endif %}
                  {% endcomment %}

                {% when 'delivery_estimate' %}
                  <div class="cwc-bundle-product-template__delivery" {{ block.shopify_attributes }}>
                    {% render 'CWC_delivery_estimate', product: product, section_id: section.id, block: block %}
                  </div>

                {% when 'add_to_cart' %}
                  <div class="cwc-bundle-product-template__add_to_cart" {{ block.shopify_attributes }}>
                    {% render 'CWC_add_to_cart', product: product, section_id: section.id, block: block %}
                  </div>

                {% when 'guarantee_text' %}
                  <div class="cwc-bundle-product-template__guarantee_text" {{ block.shopify_attributes }}>
                    {% render 'CWC_guarantee_text', product: product, section_id: section.id, block: block %}
                  </div>

                {% when 'faq' %}
                  <div class="cwc-bundle-product-template__faq mobile__only" {{ block.shopify_attributes }}>
                    {% render 'CWC_faq_blocks', product: product, section_id: section.id, block: block %}
                  </div>
              {% endcase %}
            {% endfor %}
          </form>

          {{ 'CWC_bundle_product_template.js' | asset_url | script_tag }}
        {% endif %}
      </div>
    </div>
  </div>
</section>

