{% style %}
    #cwc_footer-{{ section.id }} {
      --section-bg: {{ section.settings.bg_color | default: '#176b6c' }};
      --text-color: {{ section.settings.text_color | default: '#FFFFFF' }};
      --text-hover-color: {{ section.settings.text_hover_color | default: '#E8EDE9' }};
      --title-color: {{ section.settings.title_color | default: '#FFFFFF' }};
      --highlight-color: {{ section.settings.bold_color | default: '#A8D6B8' }};
      --divider-color: {{ section.settings.divider_color | default: 'rgba(255,255,255,0.18)' }};
      --input-bg: {{ section.settings.input_bg | default: '#0C5A4D' }};
      --input-border: {{ section.settings.input_border | default: 'rgba(255,255,255,0.30)' }};
      --input-text: {{ section.settings.input_text | default: '#FFFFFF' }};
      --input-placeholder: {{ section.settings.input_placeholder | default: 'rgba(255,255,255,0.55)' }};
      --btn-bg: {{ section.settings.btn_bg | default: '#FFFFFF' }};
      --btn-bg-hover: {{ section.settings.btn_bg_hover | default: '#F0F0F0' }};
      --btn-text: {{ section.settings.btn_text | default: '#0C5A4D' }};
      --btn-radius: {{ section.settings.btn_radius | default: 4 }}px;
      --disclaimer-color: {{ section.settings.disclaimer_color | default: 'rgba(255,255,255,0.7)' }};
      --copyright-color: {{ section.settings.copyright_color | default: 'rgba(255,255,255,0.85)' }};
      --padding-top: {{ section.settings.padding_top | default: 60 }}px;
      --padding-bottom: {{ section.settings.padding_bottom | default: 40 }}px;
      --padding-top-mobile: {{ section.settings.padding_top | default: 60 | times: 0.5 }}px;
      --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 40 | times: 0.5 }}px;
    }
{% endstyle %}

{{ 'CWC_footer.css' | asset_url | stylesheet_tag }}

<footer
  id="cwc_footer-{{ section.id }}"
  class="cwc_footer"
  data-section-id="{{ section.id }}"
  data-section-type="footer"
>
  <div class="cwc_footer__container">
    {%- comment -%} ===== Row 1: 3-column top (logo · newsletter · menu) ===== {%- endcomment -%}
    <div class="cwc_footer__top">
      {%- comment -%} Logo column {%- endcomment -%}
      <div class="cwc_footer__col cwc_footer__col--logo">
        {% if section.settings.logo != blank %}
          <a
            href="{{ routes.root_url }}"
            class="cwc_footer__logo-link"
            style="max-width: {{ section.settings.logo_width }}px;"
          >
            {{
              section.settings.logo
              | image_url: width: 400
              | image_tag: loading: 'lazy', class: 'cwc_footer__logo', alt: shop.name
            }}
          </a>
        {% elsif section.settings.logo_text != blank %}
          <a href="{{ routes.root_url }}" class="cwc_footer__logo-text">
            {{ section.settings.logo_text }}
          </a>
        {% endif %}

        {% if section.settings.logo_address != blank %}
          <div class="cwc_footer__address rte">
            {{ section.settings.logo_address }}
          </div>
        {% endif %}
      </div>

      {%- comment -%} Newsletter column {%- endcomment -%}
      <div class="cwc_footer__col cwc_footer__col--newsletter">
        {% if section.settings.newsletter_heading != blank %}
          <h4 class="cwc_footer__heading">{{ section.settings.newsletter_heading }}</h4>
        {% endif %}

        {% if section.settings.newsletter_subheading != blank %}
          <div class="cwc_footer__subheading cwc-rte">{{ section.settings.newsletter_subheading }}</div>
        {% endif %}

        <div class="cwc_footer__newsletter">
          {% form 'customer', id: 'cwc-footer-newsletter', class: 'cwc_footer__newsletter cwc_newsletter-form' %}
            {{ form.errors | default_errors }}
            {% if form.posted_successfully? %}
              <p class="cwc_footer__newsletter-success" role="status">
                {{ section.settings.newsletter_success | default: 'Thanks for subscribing!' }}
              </p>
            {% else %}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div class="cwc_footer__newsletter-field">
                <label class="visually-hidden" for="CwcFooterEmail-{{ section.id }}">
                  {{ section.settings.newsletter_placeholder | default: 'Your Email' }}
                </label>
                <input
                  type="email"
                  id="CwcFooterEmail-{{ section.id }}"
                  name="contact[email]"
                  class="cwc_footer__newsletter-input"
                  value="{{ form.email }}"
                  placeholder="{{ section.settings.newsletter_placeholder | default: 'Your Email' }}"
                  autocorrect="off"
                  autocapitalize="off"
                  autocomplete="email"
                  spellcheck="false"
                  required
                >
                <button type="submit" class="cwc_footer__newsletter-submit" name="commit">
                  {{ section.settings.newsletter_submit | default: 'Submit' }}
                </button>
              </div>
            {% endif %}
          {% endform %}
        </div>
      </div>

      {%- comment -%} Menu column {%- endcomment -%}
      <div class="cwc_footer__col cwc_footer__col--menu">
        {% if section.settings.menu_heading != blank %}
          <h4 class="cwc_footer__heading">{{ section.settings.menu_heading }}</h4>
        {% endif %}

        {% if section.settings.menu != blank and linklists[section.settings.menu].links.size > 0 %}
          <ul class="cwc_footer__menu">
            {% for link in linklists[section.settings.menu].links %}
              <li class="cwc_footer__menu-item">
                <a href="{{ link.url }}">{{ link.title }}</a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    </div>

    {%- comment -%} ===== Row 2: Optional disclaimer / text ===== {%- endcomment -%}
    {% if section.settings.disclaimer != blank %}
      <div class="cwc_footer__disclaimer cwc-rte">
        {{ section.settings.disclaimer }}
      </div>
    {% endif %}

    {%- comment -%} ===== Row 3: Localization ===== {%- endcomment -%}
    {% if section.settings.enable_currency or section.settings.enable_language %}
      <div class="cwc_footer__localization">
        {%- liquid
          if section.settings.enable_currency and localization.available_countries.size > 1
            render 'localization', id: 'CwcFooterCountryForm', enable_image: section.settings.enable_country_image, enable_name: section.settings.enable_country_name, idCountryList: 'CwcFooterCountryList'
          endif
          if section.settings.enable_language and localization.available_languages.size > 1
            render 'localization-language', id: 'CwcFooterLanguageForm', enable_name: section.settings.enable_country_name, idlist: 'CwcFooterLanguageList'
          endif
        -%}
      </div>
    {% endif %}

    {%- comment -%} ===== Row 4: Copyright ===== {%- endcomment -%}
    <div class="cwc_footer__copyright">
      {% if section.settings.use_default_copyright %}
        &copy; {{ 'now' | date: '%Y' }}
        {{ shop.name }} | All Rights Reserved
      {% else %}
        {{ section.settings.custom_copyright }}
      {% endif %}
    </div>

    <div class="cwc_footer__payment-icons">
      {%- if shop.enabled_payment_types != empty -%}
        <ul id="cwc_footer-payment-methods" class="list-inline payment-icons text-center text-lg-right">
          {%- for type in shop.enabled_payment_types -%}
            <li class="list-inline-item">
              {{ type | payment_type_svg_tag: class: 'payment-icon' }}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{{ 'CWC_footer.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "CWC Footer",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 40,
      "max": 300,
      "step": 5,
      "unit": "px",
      "default": 110
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text (fallback if no image)",
      "info": "Used when no logo image is set.",
      "default": "BRAND"
    },
    {
      "type": "richtext",
      "id": "logo_address",
      "label": "Text under logo",
      "info": "Business name and address shown beneath the logo.",
      "default": "<p>Simply Revival<br>4301 Valley Blvd<br>Los Angeles, CA 90032</p>"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Heading",
      "default": "Stay In The Know"
    },
    {
      "type": "richtext",
      "id": "newsletter_subheading",
      "label": "Subheading",
      "default": "<p>Sign up for newsletters, special offers and exclusive discounts!</p>"
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Input placeholder",
      "default": "Your Email"
    },
    {
      "type": "text",
      "id": "newsletter_submit",
      "label": "Submit button label",
      "default": "Submit"
    },
    {
      "type": "text",
      "id": "newsletter_success",
      "label": "Success message",
      "default": "Thanks for subscribing!"
    },
    {
      "type": "header",
      "content": "Menu"
    },
    {
      "type": "text",
      "id": "menu_heading",
      "label": "Menu heading (optional)"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "footer",
      "info": "Dropdown items are not rendered."
    },
    {
      "type": "header",
      "content": "Disclaimer Text"
    },
    {
      "type": "richtext",
      "id": "disclaimer",
      "label": "Disclaimer / legal text (optional)",
      "info": "Renders below the top row. Leave blank to hide.",
      "default": "<p><em>For cosmetic and nutritional support purposes only.</em></p><p>*These statements have not been evaluated by the Food and Drug Administration.</p><p>*This product is not intended to diagnose, treat, cure, or prevent any disease.</p><p>* Individual results may vary.Testimonials and reviews reflect individual experiences and are not guaranteed outcomes.</p>"
    },
    {
      "type": "header",
      "content": "Localization"
    },
    {
      "type": "checkbox",
      "id": "enable_currency",
      "label": "Enable currency selector",
      "default": true,
      "info": "Manage in [currency settings](/admin/settings/payments)."
    },
    {
      "type": "checkbox",
      "id": "enable_country_image",
      "label": "Show country flag",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_country_name",
      "label": "Show country / language name",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_language",
      "label": "Enable language selector",
      "default": false,
      "info": "Manage in [language settings](/admin/settings/languages)."
    },
    {
      "type": "header",
      "content": "Copyright"
    },
    {
      "type": "checkbox",
      "id": "use_default_copyright",
      "label": "Use default copyright",
      "info": "If disabled, the custom copyright text below is used.",
      "default": true
    },
    {
      "type": "textarea",
      "id": "custom_copyright",
      "label": "Custom copyright",
      "default": "© Your Store | All Rights Reserved"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#176b6c"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#E8EDE9"
    },
    {
      "type": "color",
      "id": "text_hover_color",
      "label": "Text (hover)",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Heading text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Highlight (bold) color",
      "default": "#A8D6B8"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Column divider",
      "default": "#1E6B5E"
    },
    {
      "type": "color",
      "id": "disclaimer_color",
      "label": "Disclaimer text",
      "default": "#B8C4BD"
    },
    {
      "type": "color",
      "id": "copyright_color",
      "label": "Copyright text",
      "default": "#D8DDD9"
    },
    {
      "type": "header",
      "content": "Newsletter Input & Button"
    },
    {
      "type": "color",
      "id": "input_bg",
      "label": "Input background",
      "default": "#0C5A4D"
    },
    {
      "type": "color",
      "id": "input_border",
      "label": "Input border",
      "default": "#2A7869"
    },
    {
      "type": "color",
      "id": "input_text",
      "label": "Input text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "input_placeholder",
      "label": "Input placeholder",
      "default": "#B0C4BC"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "btn_bg_hover",
      "label": "Button background (hover)",
      "default": "#F0F0F0"
    },
    {
      "type": "color",
      "id": "btn_text",
      "label": "Button text",
      "default": "#0C5A4D"
    },
    {
      "type": "range",
      "id": "btn_radius",
      "label": "Button corner radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "New Footer",
      "category": "CWC Custom"
    }
  ]
}
{% endschema %}
