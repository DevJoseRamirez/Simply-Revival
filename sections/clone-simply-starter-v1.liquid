{%- comment -%} ═════════ SWIPER INITS (CDN onload) ═════════ {%- endcomment -%}
<script>
  function cloneSwiperInit_simplystarterv1() {
    var root = document.getElementById('clone-simply-starter-v1');
    if (!root || typeof Swiper === 'undefined') return;

    // ── Gallery main + thumbs ──
    try {
      var main = document.getElementById('g-main-simplystarterv1');
      var thumbs = document.getElementById('g-thumbs-simplystarterv1');
      if (main) {
        var thumbSwiper = null;
        if (thumbs) {
          var thumbEl = thumbs.querySelector('.swiper');
          if (thumbEl)
            thumbSwiper = new Swiper(thumbEl, {
              slidesPerView: 5,
              spaceBetween: 4,
              watchSlidesProgress: true,
              slideToClickedSlide: true,
            });
        }
        var mainSwiper = new Swiper(main, {
          loop: false,
          spaceBetween: 4,
          speed: 400,
          navigation: {
            nextEl: '#g-main-simplystarterv1 .swiper-button-next',
            prevEl: '#g-main-simplystarterv1 .swiper-button-prev',
          },
          thumbs: thumbSwiper ? { swiper: thumbSwiper } : undefined,
          on: {
            slideChange: function () {
              if (!thumbs) return;
              var items = thumbs.querySelectorAll('.g-thumb');
              var idx = this.realIndex;
              items.forEach(function (t, i) {
                t.classList.toggle('active', i === idx);
              });
            },
          },
        });
        if (thumbs)
          thumbs.querySelectorAll('.g-thumb').forEach(function (thumb, i) {
            thumb.addEventListener('click', function () {
              mainSwiper.slideTo(i);
            });
          });
      }
    } catch (e) {}

    // ── Gallery testimonial (auto-rotating, left column) ──
    try {
      if (document.getElementById('gtst-simplystarterv1')) {
        new Swiper('#gtst-simplystarterv1', {
          slidesPerView: 1,
          spaceBetween: 0,
          loop: true,
          speed: 500,
          autoplay: { delay: 4500, disableOnInteraction: false },
          pagination: { el: '#clone-simply-starter-v1 .gtst-pagination', clickable: true },
        });
      }
    } catch (e) {}

    // ── Generic carousel helper (progress bar + arrows via data-*) ──
    function initCarousel(sel, key, opts) {
      try {
        var extra = opts || {};
        var cfg = {
          slidesPerView: extra.base || 1.1,
          spaceBetween: 16,
          loop: !!extra.loop,
          speed: 400,
          navigation: { nextEl: '[data-next="' + key + '"]', prevEl: '[data-prev="' + key + '"]' },
          breakpoints: extra.breakpoints || { 768: { slidesPerView: 2 }, 1024: { slidesPerView: extra.desktop || 3 } },
          on: {
            slideChange: function () {
              var bar = document.querySelector('[data-bar="' + key + '"]');
              if (bar) bar.style.width = ((this.realIndex + 1) / this.slides.length) * 100 + '%';
            },
          },
        };
        new Swiper(sel, cfg);
      } catch (e) {}
    }

    initCarousel('#imgc-simplystarterv1', 'imgc', { base: 1.2, loop: true, desktop: 3 });
    initCarousel('#tst-simplystarterv1', 'tst', { base: 1, loop: true, desktop: 3 });
    initCarousel('#sp-simplystarterv1', 'sp', {
      base: 1.4,
      loop: true,
      breakpoints: { 768: { slidesPerView: 3 }, 1024: { slidesPerView: 4 } },
    });
    initCarousel('#ugc-simplystarterv1', 'ugc', {
      base: 1.4,
      loop: true,
      desktop: 4,
      breakpoints: { 768: { slidesPerView: 3 }, 1024: { slidesPerView: 4 } },
    });
  }
</script>

{%- comment -%} ═════════ NON-SWIPER JS (tabs + ATC) ═════════ {%- endcomment -%}
<script>
  (function () {
    'use strict';
    var root = document.getElementById('clone-simply-starter-v1');
    if (!root) return;

    // ── Tabs (both tab groups) ──
    root.querySelectorAll('[data-tabs]').forEach(function (grp) {
      var btns = grp.querySelectorAll('.tab-btn');
      var panels = grp.querySelectorAll('.tab-panel');
      btns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var i = btn.getAttribute('data-tab');
          btns.forEach(function (b) {
            b.setAttribute('aria-selected', b === btn ? 'true' : 'false');
          });
          panels.forEach(function (pnl) {
            pnl.classList.toggle('is-active', pnl.getAttribute('data-panel') === i);
          });
        });
      });
    });

    // ── ATC (self-contained AJAX + sticky) ──
    var scope = root.querySelector('.clone-atc-simplystarterv1');
    var sticky = document.querySelector('.clone-sticky-atc-simplystarterv1');
    var staticBtn = document.getElementById('clone-simply-starter-v1-atc');

    function openCartOrFallback() {
      try {
        document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
        document.dispatchEvent(new CustomEvent('cart-drawer:open', { bubbles: true }));
        var drawer = document.querySelector('cart-drawer, #CartDrawer, .cart-drawer, [data-cart-drawer]');
        if (drawer) {
          if (typeof drawer.open === 'function') {
            drawer.open();
            return;
          }
          drawer.classList.add('active', 'is-open', 'open');
          document.body.classList.add('cart-drawer-open');
          return;
        }
      } catch (e) {}
      window.location.href = window.routes && window.routes.cart_url ? window.routes.cart_url : '/cart';
    }
    function addToCart(btn) {
      var variantId = btn.getAttribute('data-variant-id');
      if (!variantId) {
        window.location.href = '/cart';
        return;
      }
      btn.classList.add('is-loading');
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: [{ id: Number(variantId), quantity: 1 }] }),
      })
        .then(function (r) {
          return r.json();
        })
        .then(function () {
          btn.classList.remove('is-loading');
          openCartOrFallback();
        })
        .catch(function () {
          btn.classList.remove('is-loading');
          alert('Could not add to cart. Please try again.');
        });
    }
    [scope, sticky].forEach(function (container) {
      if (!container) return;
      container.querySelectorAll('.clone-atc__button').forEach(function (btn) {
        if (btn.disabled) return;
        btn.addEventListener('click', function () {
          addToCart(btn);
        });
      });
    });
    if (sticky && staticBtn) {
      var io = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) sticky.classList.remove('is-visible');
            else sticky.classList.toggle('is-visible', staticBtn.getBoundingClientRect().bottom < 0);
          });
        },
        { threshold: 0 }
      );
      io.observe(staticBtn);
    }
  })();
</script>

