{%- comment -%}
  ═══════════════════════════════════════════════════════════════
  CLONE — simply-starter-v1
  Source: mengotomars.com/products/30-day-supply-starter-kit (dark PDP)
  Reskinned to Simply Revival (light: white/cream/dark-teal). ONE self-contained
  section. Interactive parts ported from _reference-components (Swiper via CDN).
  All CSS scoped under #clone-simply-starter-v1-*. One schema setting: product.
  ═══════════════════════════════════════════════════════════════
{%- endcomment -%}

{%- assign p = section.settings.product -%}

{%- comment -%} ── Swiper (CDN, deterministic — do not rely on theme's copy) ── {%- endcomment -%}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">

<style>
  #clone-simply-starter-v1 {
    /* Brand tokens (Simply Revival) */
    --sr-text: #282828;
    --sr-accent: #72c9ca;
    --sr-bg: #ffffff;
    --sr-cream: #fffee3;
    --sr-teal: #125657;
    --sr-grey: #f7f7f5;
    --sr-cta-bg: #125657;
    --sr-cta-text: #ffffff;
    --sr-muted: #555555;
    --sr-check: #1a9e5f; /* semantic */
    --sr-cross: #d64545; /* semantic */
    --sr-quest: #999999;
    /* Type scale */
    --fs-xs: 0.75rem;
    --fs-sm: 0.875rem;
    --fs-base: 1rem;
    --fs-md: 1.125rem;
    --fs-lg: 1.375rem;
    --fs-xl: 1.75rem;
    --fs-2xl: 2.25rem;
    --fs-3xl: 3rem;

    background: var(--sr-bg);
    color: var(--sr-text);
    font-size: var(--fs-base);
    line-height: 1.5;
    overflow-x: hidden;
  }
  #clone-simply-starter-v1 * {
    box-sizing: border-box;
  }
  #clone-simply-starter-v1 img {
    max-width: 100%;
  }
  #clone-simply-starter-v1 .cl-wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }
  #clone-simply-starter-v1 .cl-section {
    padding: 56px 0;
  }
  #clone-simply-starter-v1 .cl-bg-cream {
    background: var(--sr-cream);
  }
  #clone-simply-starter-v1 .cl-bg-grey {
    background: var(--sr-grey);
  }
  #clone-simply-starter-v1 .cl-bg-teal {
    background: var(--sr-teal);
    color: #fff;
  }
  #clone-simply-starter-v1 h2.cl-h {
    text-align: center;
    font-weight: 800;
    font-size: var(--fs-2xl);
    margin: 0 0 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    line-height: 1.15;
  }
  #clone-simply-starter-v1 h2.cl-h strong {
    color: var(--sr-accent);
  }
  #clone-simply-starter-v1 .cl-sub {
    text-align: center;
    color: var(--sr-muted);
    max-width: 640px;
    margin: 0 auto 2.25rem;
    font-size: var(--fs-md);
  }
  #clone-simply-starter-v1 .cl-bg-teal .cl-sub {
    color: rgba(255, 255, 255, 0.85);
  }
  #clone-simply-starter-v1 .cl-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--sr-cta-bg);
    color: var(--sr-cta-text);
    padding: 1rem 2.25rem;
    border-radius: 6px;
    font-weight: 700;
    font-size: var(--fs-md);
    text-decoration: none;
    border: 2px solid var(--sr-teal);
    cursor: pointer;
    transition: all 0.2s ease;
  }
  #clone-simply-starter-v1 .cl-cta:hover {
    background: transparent;
    color: var(--sr-teal);
  }
  #clone-simply-starter-v1 .cl-bg-teal .cl-cta {
    background: #fff;
    color: var(--sr-teal);
    border-color: #fff;
  }
  #clone-simply-starter-v1 .cl-bg-teal .cl-cta:hover {
    background: transparent;
    color: #fff;
  }
  #clone-simply-starter-v1 .cl-center {
    text-align: center;
  }

  /* ─────────────  1. HERO  ───────────── */
  #clone-simply-starter-v1 .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }
  #clone-simply-starter-v1 .hero-title {
    font-size: var(--fs-2xl);
    font-weight: 800;
    margin: 0 0 0.5rem;
    line-height: 1.15;
  }
  #clone-simply-starter-v1 .hero-rating {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--fs-sm);
    color: var(--sr-muted);
    margin-bottom: 0.75rem;
  }
  #clone-simply-starter-v1 .hero-stars {
    color: var(--sr-accent);
    letter-spacing: 1px;
  }
  #clone-simply-starter-v1 .hero-lede {
    font-size: var(--fs-md);
    color: var(--sr-muted);
    margin: 0 0 1rem;
  }
  #clone-simply-starter-v1 .hero-bullets {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
  }
  #clone-simply-starter-v1 .hero-bullets li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    margin-bottom: 0.6rem;
    font-weight: 600;
  }
  #clone-simply-starter-v1 .hero-bullets .ck {
    color: var(--sr-teal);
    flex-shrink: 0;
    font-weight: 800;
  }

  /* offer / price box */
  #clone-simply-starter-v1 .offer-box {
    border: 2px solid var(--sr-teal);
    border-radius: 12px;
    padding: 1.25rem;
    background: var(--sr-cream);
    margin-bottom: 1rem;
  }
  #clone-simply-starter-v1 .offer-price {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }
  #clone-simply-starter-v1 .offer-now {
    font-size: var(--fs-2xl);
    font-weight: 800;
    color: var(--sr-teal);
  }
  #clone-simply-starter-v1 .offer-was {
    font-size: var(--fs-md);
    text-decoration: line-through;
    color: var(--sr-muted);
  }
  #clone-simply-starter-v1 .offer-badge {
    display: inline-block;
    background: var(--sr-teal);
    color: #fff;
    font-size: var(--fs-xs);
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: 20px;
    margin-left: auto;
  }
  #clone-simply-starter-v1 .offer-sub {
    font-size: var(--fs-sm);
    color: var(--sr-muted);
    margin-top: 0.5rem;
  }
  #clone-simply-starter-v1 .hero-trust {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 1rem;
    text-align: center;
  }
  #clone-simply-starter-v1 .hero-trust div {
    font-size: var(--fs-xs);
    color: var(--sr-muted);
    flex: 1;
  }
  #clone-simply-starter-v1 .hero-trust .ic {
    font-size: 1.3rem;
    display: block;
    margin-bottom: 0.25rem;
  }

  /* gallery (ported product-gallery-1) */
  #clone-simply-starter-v1 .g-main {
    position: relative;
    width: 100%;
  }
  #clone-simply-starter-v1 .g-main .swiper-slide img {
    width: 100%;
    height: auto;
    object-fit: contain;
    aspect-ratio: 1/1;
    display: block;
    background: #fff;
    border-radius: 12px;
  }
  #clone-simply-starter-v1 .g-main .swiper-button-next,
  #clone-simply-starter-v1 .g-main .swiper-button-prev {
    color: var(--sr-teal);
  }
  #clone-simply-starter-v1 .g-thumbs {
    margin-top: 0.75rem;
  }
  #clone-simply-starter-v1 .g-thumbs .swiper-slide {
    width: calc((100% - 32px) / 5) !important;
  }
  #clone-simply-starter-v1 .g-thumb {
    width: 100%;
    aspect-ratio: 1/1;
    overflow: hidden;
    cursor: pointer;
    border: 2px solid transparent;
    border-radius: 8px;
    transition: border-color 0.3s ease;
  }
  #clone-simply-starter-v1 .g-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #clone-simply-starter-v1 .g-thumb.active {
    border-color: var(--sr-teal);
  }

  /* gallery testimonial carousel (left column, under thumbs — matches reference) */
  #clone-simply-starter-v1 .g-testimonial {
    margin-top: 1rem;
  }
  #clone-simply-starter-v1 .gtst-carousel {
    border: 1px solid #e7e6d5;
    border-radius: 10px;
    background: var(--sr-grey);
    overflow: hidden;
  }
  #clone-simply-starter-v1 .gtst-card {
    padding: 1.1rem 1.25rem;
  }
  #clone-simply-starter-v1 .gtst-quote {
    margin: 0 0 0.75rem;
    font-size: var(--fs-sm);
    color: var(--sr-text);
    line-height: 1.55;
  }
  #clone-simply-starter-v1 .gtst-quote b {
    color: var(--sr-text);
  }
  #clone-simply-starter-v1 .gtst-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  #clone-simply-starter-v1 .gtst-stars {
    color: var(--sr-accent);
    letter-spacing: 1px;
  }
  #clone-simply-starter-v1 .gtst-author {
    font-size: var(--fs-xs);
    color: var(--sr-muted);
    font-weight: 700;
  }
  #clone-simply-starter-v1 .gtst-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.6rem;
  }
  #clone-simply-starter-v1 .gtst-pagination {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  #clone-simply-starter-v1 .gtst-pagination .swiper-pagination-bullet {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #cfcfbf;
    opacity: 1;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  #clone-simply-starter-v1 .gtst-pagination .swiper-pagination-bullet-active {
    background: var(--sr-teal);
    width: 18px;
    border-radius: 4px;
  }

  /* supplement-facts button (left column, under testimonial — matches reference) */
  #clone-simply-starter-v1 .g-label-toggle {
    margin-top: 1rem;
  }
  #clone-simply-starter-v1 .g-label-toggle summary {
    list-style: none;
    cursor: pointer;
    display: block;
    text-align: center;
    border: 2px solid var(--sr-teal);
    color: var(--sr-teal);
    font-weight: 700;
    padding: 0.85rem 1rem;
    border-radius: 8px;
    transition: all 0.2s ease;
  }
  #clone-simply-starter-v1 .g-label-toggle summary::-webkit-details-marker {
    display: none;
  }
  #clone-simply-starter-v1 .g-label-toggle summary:hover {
    background: var(--sr-teal);
    color: #fff;
  }
  #clone-simply-starter-v1 .g-label-toggle img {
    margin-top: 1rem;
    border-radius: 8px;
    width: 100%;
  }

  /* free gifts inside hero content column (matches reference) */
  #clone-simply-starter-v1 .hero-disc {
    font-size: var(--fs-xs);
    color: var(--sr-muted);
    text-align: center;
    margin-top: 1rem;
  }
  #clone-simply-starter-v1 .hero-gifts {
    margin-top: 1.5rem;
  }
  #clone-simply-starter-v1 .hg-head {
    text-align: center;
    font-weight: 800;
    text-transform: uppercase;
    font-size: var(--fs-md);
    letter-spacing: 0.5px;
    margin: 0 0 1rem;
  }
  #clone-simply-starter-v1 .hg-head strong {
    color: var(--sr-accent);
  }
  #clone-simply-starter-v1 .hg-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.6rem;
  }
  #clone-simply-starter-v1 .hg-card {
    text-align: center;
  }
  #clone-simply-starter-v1 .hg-thumb {
    position: relative;
    background: #fff;
    border: 1px solid #e7e6d5;
    border-radius: 8px;
    padding: 0.5rem;
    aspect-ratio: 1/1;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #clone-simply-starter-v1 .hg-thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  #clone-simply-starter-v1 .hg-badge {
    position: absolute;
    top: 0.3rem;
    left: 0.3rem;
    background: var(--sr-teal);
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
  }
  #clone-simply-starter-v1 .hg-name {
    font-size: var(--fs-xs);
    font-weight: 600;
    margin-top: 0.4rem;
    line-height: 1.2;
  }

  /* ─────────────  TABS (shared: PDP tabs + week tabs)  ───────────── */
  #clone-simply-starter-v1 .tabs-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    margin-bottom: 1.5rem;
  }
  #clone-simply-starter-v1 .tab-btn {
    padding: 0.6rem 1.1rem;
    border: 1.5px solid var(--sr-teal);
    background: transparent;
    color: var(--sr-teal);
    font-weight: 600;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
    font-size: var(--fs-sm);
  }
  #clone-simply-starter-v1 .tab-btn[aria-selected='true'] {
    background: var(--sr-teal);
    color: #fff;
  }
  #clone-simply-starter-v1 .tab-panel {
    display: none;
  }
  #clone-simply-starter-v1 .tab-panel.is-active {
    display: block;
  }

  /* PDP timeline (tab 1) */
  #clone-simply-starter-v1 .timeline {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  #clone-simply-starter-v1 .tl-col h3 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--fs-lg);
    margin: 0 0 0.75rem;
    color: var(--sr-teal);
  }
  #clone-simply-starter-v1 .tl-col ul {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--sr-muted);
  }
  #clone-simply-starter-v1 .tl-col li {
    margin-bottom: 0.4rem;
  }
  #clone-simply-starter-v1 .pdp-panel {
    background: #fff;
    border: 1px solid #e7e6d5;
    border-radius: 12px;
    padding: 1.75rem;
  }
  #clone-simply-starter-v1 .pdp-panel h3.panel-h {
    margin-top: 0;
  }

  /* week tabs panel (2-col text/media) */
  #clone-simply-starter-v1 .wk-panel.is-active {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: center;
    background: var(--sr-grey);
    border-radius: 12px;
    padding: 2rem;
  }
  #clone-simply-starter-v1 .wk-panel h3 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--fs-lg);
    margin: 0 0 0.75rem;
  }
  #clone-simply-starter-v1 .wk-panel h3 span.num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--sr-teal);
    color: #fff;
    font-size: var(--fs-sm);
    flex-shrink: 0;
  }
  #clone-simply-starter-v1 .wk-panel p {
    color: var(--sr-muted);
    margin: 0 0 1rem;
  }
  #clone-simply-starter-v1 .wk-bh {
    font-weight: 700;
    margin: 1rem 0 0.5rem;
  }
  #clone-simply-starter-v1 .wk-panel ul {
    margin: 0;
    padding-left: 1.2rem;
    color: var(--sr-muted);
  }
  #clone-simply-starter-v1 .wk-panel li {
    margin-bottom: 0.4rem;
  }
  #clone-simply-starter-v1 .wk-media img {
    width: 100%;
    border-radius: 8px;
    display: block;
  }
  #clone-simply-starter-v1 .wk-chart {
    margin-top: 0.75rem;
    background: #fff;
    border-radius: 8px;
    padding: 0.75rem;
  }
  #clone-simply-starter-v1 .wk-chart svg {
    width: 100%;
    height: auto;
    display: block;
  }
  #clone-simply-starter-v1 .wk-disc {
    font-size: var(--fs-xs);
    color: var(--sr-muted);
    margin-top: 0.5rem;
  }

  /* ─────────────  4. INGREDIENTS (grid)  ───────────── */
  #clone-simply-starter-v1 .ing-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  #clone-simply-starter-v1 .ing-card {
    background: #fff;
    border: 1px solid #e7e6d5;
    border-radius: 10px;
    overflow: hidden;
  }
  #clone-simply-starter-v1 .ing-card .ing-img {
    width: 100%;
    aspect-ratio: 4/3;
    overflow: hidden;
    background: var(--sr-grey);
  }
  #clone-simply-starter-v1 .ing-card .ing-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #clone-simply-starter-v1 .ing-body {
    padding: 1rem;
  }
  #clone-simply-starter-v1 .ing-body h3 {
    font-size: var(--fs-md);
    margin: 0 0 0.25rem;
  }
  #clone-simply-starter-v1 .ing-tag {
    display: inline-block;
    background: rgba(114, 201, 202, 0.18);
    color: var(--sr-teal);
    font-size: var(--fs-xs);
    font-weight: 700;
    padding: 0.15rem 0.55rem;
    border-radius: 20px;
    margin-bottom: 0.5rem;
  }
  #clone-simply-starter-v1 .ing-body p {
    font-size: var(--fs-sm);
    color: var(--sr-muted);
    margin: 0;
  }

  /* ─────────────  5. DESCRIPTION + LAB  ───────────── */
  #clone-simply-starter-v1 .desc-block {
    max-width: 780px;
    margin: 0 auto;
    text-align: center;
  }
  #clone-simply-starter-v1 .desc-block ul {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0;
    display: inline-block;
    text-align: left;
  }
  #clone-simply-starter-v1 .desc-block li {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  #clone-simply-starter-v1 .desc-block li .ck {
    color: var(--sr-teal);
    font-weight: 800;
  }
  #clone-simply-starter-v1 .lab-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: #fff;
    border: 1px solid #e7e6d5;
    border-radius: 10px;
    padding: 0.6rem 1rem;
    margin: 1rem 0 1.75rem;
    font-size: var(--fs-sm);
  }
  #clone-simply-starter-v1 .lab-badge img {
    width: 40px;
    height: 40px;
    object-fit: contain;
  }

  /* ─────────────  6/9. IMAGE CAROUSELS  ───────────── */
  #clone-simply-starter-v1 .imgc-carousel,
  #clone-simply-starter-v1 .ugc-carousel {
    position: relative;
    overflow: hidden;
    padding: 0.5rem 0;
  }
  #clone-simply-starter-v1 .imgc-card {
    border: 1px solid #dfdfdf;
    border-radius: 10px;
    overflow: hidden;
    filter: drop-shadow(0 4px 4px rgba(0, 0, 0, 0.12));
    position: relative;
  }
  #clone-simply-starter-v1 .imgc-card img {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
  }
  #clone-simply-starter-v1 .imgc-label {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    padding: 0.4rem 0.6rem;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.55));
    color: #fff;
    font-size: var(--fs-xs);
    font-weight: 700;
  }
  #clone-simply-starter-v1 .ugc-tag {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    background: var(--sr-teal);
    color: #fff;
    font-size: var(--fs-xs);
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 20px;
    text-transform: uppercase;
  }
  #clone-simply-starter-v1 .ugc-play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #clone-simply-starter-v1 .ugc-play span {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    color: var(--sr-teal);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
  }
  #clone-simply-starter-v1 .cl-controls {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    margin-top: 1.25rem;
  }
  #clone-simply-starter-v1 .cl-progress {
    height: 4px;
    background: rgba(0, 0, 0, 0.1);
    border-radius: 2px;
    overflow: hidden;
    max-width: 280px;
    margin: 1.5rem auto 0;
  }
  #clone-simply-starter-v1 .cl-progress-bar {
    height: 100%;
    width: 0%;
    background: var(--sr-teal);
    transition: width 0.3s linear;
  }
  #clone-simply-starter-v1 .cl-bg-teal .cl-progress {
    background: rgba(255, 255, 255, 0.25);
  }
  #clone-simply-starter-v1 .cl-bg-teal .cl-progress-bar {
    background: #fff;
  }

  /* ─────────────  7. REVIEW CARDS SLIDER  ───────────── */
  #clone-simply-starter-v1 .tst-carousel {
    position: relative;
    overflow: hidden;
  }
