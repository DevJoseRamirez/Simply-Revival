<div id="clone-simply-starter-v1">
  {%- comment -%} ═════════ 1. HERO ═════════ {%- endcomment -%}
  <section class="cl-section">
    <div class="cl-wrap hero-grid">
      {%- comment -%} Gallery (ported product-gallery-1 → p.images) {%- endcomment -%}
      <div class="hero-gallery">
        <div class="swiper g-main" id="g-main-simplystarterv1">
          <div class="swiper-wrapper">
            {% if p.images.size > 0 %}
              {% for image in p.images limit: 8 %}
                <div class="swiper-slide">
                  <img
                    src="{{ image | image_url: width: 700 }}"
                    alt="{{ image.alt | default: p.title }}"
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  >
                </div>
              {% endfor %}
            {% else %}
              <div class="swiper-slide"><img src="https://placehold.co/700x700?text=Product" alt="Product"></div>
            {% endif %}
          </div>
          <div class="swiper-button-prev"></div>
          <div class="swiper-button-next"></div>
        </div>
        {% if p.images.size > 1 %}
          <div class="g-thumbs" id="g-thumbs-simplystarterv1">
            <div class="swiper">
              <div class="swiper-wrapper">
                {% for image in p.images limit: 8 %}
                  <div class="swiper-slide">
                    <div class="g-thumb {% if forloop.first %}active{% endif %}" data-slide="{{ forloop.index0 }}">
                      <img
                        src="{{ image | image_url: width: 135 }}"
                        alt="{{ image.alt | default: p.title }}"
                        loading="lazy"
                      >
                    </div>
                  </div>
                {% endfor %}
              </div>
            </div>
          </div>
        {% endif %}

        {%- comment -%} Testimonial carousel (under thumbs, matches reference left column) {%- endcomment -%}
        <div class="g-testimonial">
          <div class="swiper gtst-carousel" id="gtst-simplystarterv1">
            <div class="swiper-wrapper">
              <div class="swiper-slide">
                <div class="gtst-card">
                  <p class="gtst-quote">
                    "It took about 2–3 weeks to notice results. <b>Less shedding and my scalp feels healthier</b> — hair
                    actually feels thicker in the shower now."
                  </p>
                  <div class="gtst-foot">
                    <span class="gtst-stars">★★★★★</span><span class="gtst-author">🌿 Jonathan S.</span>
                  </div>
                </div>
              </div>
              <div class="swiper-slide">
                <div class="gtst-card">
                  <p class="gtst-quote">
                    "Barely any hair comes out when I wash now. <b>The shedding reduction is incredible</b> and it's
                    completely natural — no harsh side effects."
                  </p>
                  <div class="gtst-foot">
                    <span class="gtst-stars">★★★★★</span><span class="gtst-author">🌿 Connor L.</span>
                  </div>
                </div>
