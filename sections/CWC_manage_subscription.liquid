{% style %}
  #cwc_manage-subscription-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --eyebrow-color: {{ section.settings.eyebrow_color | default: '#3F8060' }};
    --heading-color: {{ section.settings.heading_color | default: '#0C3B2C' }};
    --highlight-color: {{ section.settings.bold_color | default: '#3F8060' }};
    --subtext-color: {{ section.settings.subtext_color | default: '#0C3B2C' }};
    --card-bg: {{ section.settings.card_bg | default: '#EFEFE3' }};
    --card-radius: {{ section.settings.card_radius | default: 14 }}px;
    --card-heading-color: {{ section.settings.card_heading_color | default: '#0C3B2C' }};
    --btn-bg: {{ section.settings.btn_bg | default: '#125657' }};
    --btn-bg-hover: {{ section.settings.btn_bg_hover | default: '#1A5240' }};
    --btn-text: {{ section.settings.btn_text | default: '#ffffff' }};
    --btn-radius: {{ section.settings.btn_radius | default: 6 }}px;
    --padding-top: {{ section.settings.padding_top | default: 80 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 80 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 80 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_manage_subscription.css' | asset_url | stylesheet_tag }}

<section
  id="cwc_manage-subscription-{{ section.id }}"
  class="cwc_manage-subscription"
>
  <div class="cwc_manage-subscription__container">
    {%- comment -%} ===== Centered Header ===== {%- endcomment -%}
    {% if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subtext != blank %}
      <div class="cwc_manage-subscription__header">
        {% if section.settings.eyebrow != blank %}
          <span class="cwc_manage-subscription__eyebrow">{{ section.settings.eyebrow }}</span>
        {% endif %}

        {% if section.settings.heading != blank %}
          <div class="cwc_manage-subscription__heading cwc-rte">{{ section.settings.heading }}</div>
        {% endif %}

        {% if section.settings.subtext != blank %}
          <div class="cwc_manage-subscription__subtext cwc-rte">{{ section.settings.subtext }}</div>
        {% endif %}
      </div>
    {% endif %}

    {%- comment -%} ===== Cream Card with Button ===== {%- endcomment -%}
    {% if section.settings.card_heading != blank or section.settings.btn_label != blank %}
      <div class="cwc_manage-subscription__card">
        {% if section.settings.card_heading != blank %}
          <h3 class="cwc_manage-subscription__card-heading">{{ section.settings.card_heading }}</h3>
        {% endif %}

        {% if section.settings.btn_label != blank %}
          <a href="{{ section.settings.btn_link | default: '#' }}" class="cwc_manage-subscription__btn">
            <span>{{ section.settings.btn_label }} →</span>
            {% comment %} <span class="cwc_manage-subscription__btn-arrow" aria-hidden="true">→</span> {% endcomment %}
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% comment %}
  MAIN LINKS:
  Account/order: https://simplyrevival.com/account/orders
  Loop Subscriptoins:  https://simplyrevival.com/a/loop_subscriptions/get-subscription-link
{% endcomment %}

