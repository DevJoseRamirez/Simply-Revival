{% style %}
  #CWC_holiday_timer_banner-{{ section.id }} {
    --gradient-start: {{ section.settings.gradient_start | default: '#D0F0E8' }};
    --gradient-end: {{ section.settings.gradient_end | default: '#E6E0FA' }};
    --text-color: {{ section.settings.text_color | default: '#111111' }};
    --padding-top: {{ section.settings.padding_top | default: 10 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | times: 0.5 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 10 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_holiday_timer_banner.css' | asset_url | stylesheet_tag }}

{% if section.settings.main_title != blank or section.settings.show_timer %}
  <section
    id="CWC_holiday_timer_banner-{{ section.id }}"
    class="cwc-holiday-timer-banner"
  >
    <a
      class="cwc-holiday-timer-banner__container"
      href="{{ section.settings.link }}"
    >
      <div class="cwc-holiday-timer-banner__content">
        {% if section.settings.main_title != blank %}
          <div class="cwc-holiday-timer-banner__main-title rte">
            {{ section.settings.main_title }}
          </div>
        {% endif %}

        {% if section.settings.subtext != blank %}
          <div class="cwc-holiday-timer-banner__subtext rte">
            {{ section.settings.subtext }}
          </div>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="cwc-holiday-timer-banner__text rte">
            {{ section.settings.text }}
          </div>
        {% endif %}
      </div>

      {% if section.settings.show_timer %}
        <div class="cwc-holiday-timer-banner__timer-wrapper">
          <div id="timer-{{ section.id }}" class="cwc-holiday-timer-banner__timer">
            <span class="cwc-holiday-timer-banner__time-unit cwc-holiday-timer-banner__time-unit--hours">00</span>
            <span class="cwc-holiday-timer-banner__separator">:</span>
            <span class="cwc-holiday-timer-banner__time-unit cwc-holiday-timer-banner__time-unit--minutes">00</span>
            <span class="cwc-holiday-timer-banner__separator">:</span>
            <span class="cwc-holiday-timer-banner__time-unit cwc-holiday-timer-banner__time-unit--seconds">00</span>
          </div>
          <div class="cwc-holiday-timer-banner__timer-labels">
            <span class="cwc-holiday-timer-banner__label cwc-holiday-timer-banner__label--hours">Hrs</span>
            <span class="cwc-holiday-timer-banner__separator">:</span>
            <span class="cwc-holiday-timer-banner__label cwc-holiday-timer-banner__label--minutes">Mins</span>
            <span class="cwc-holiday-timer-banner__separator">:</span>
            <span class="cwc-holiday-timer-banner__label cwc-holiday-timer-banner__label--seconds">Secs</span>
          </div>
        </div>
      {% endif %}
    </a>
  </section>
{% endif %}

{% if section.settings.show_timer %}
  <script>
    'use strict';
    (function() {
      const sectionId = '{{ section.id }}';
      const timerElement = document.getElementById('timer-' + sectionId);
      if (!timerElement) return;

      const minHours = {{ section.settings.min_hours | times: 3600000 }};
      const maxHours = {{ section.settings.max_hours | times: 3600000 }};
      const localStorageKey = 'holidayTimerTarget-' + sectionId;
      let targetTime = localStorage.getItem(localStorageKey);

      if (!targetTime || new Date().getTime() > parseInt(targetTime)) {
        const randomOffset = Math.random() * (maxHours - minHours) + minHours;
        targetTime = new Date().getTime() + randomOffset;
        localStorage.setItem(localStorageKey, targetTime);
      } else {
        targetTime = parseInt(targetTime);
      }

      const hoursEl = timerElement.querySelector('.cwc-holiday-timer-banner__time-unit--hours');
      const minutesEl = timerElement.querySelector('.cwc-holiday-timer-banner__time-unit--minutes');
      const secondsEl = timerElement.querySelector('.cwc-holiday-timer-banner__time-unit--seconds');

      function updateTimer() {
        const now = new Date().getTime();
        const distance = targetTime - now;

        if (distance < 0) {
          clearInterval(timerInterval);
          timerElement.innerHTML = 'TIME IS UP!';
          return;
        }

        // Roll days into hours so display stays as HH:MM:SS
        const totalHours = Math.floor(distance / (1000 * 60 * 60));
        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((distance % (1000 * 60)) / 1000);

        hoursEl.textContent = String(totalHours).padStart(2, '0');
        minutesEl.textContent = String(minutes).padStart(2, '0');
        secondsEl.textContent = String(seconds).padStart(2, '0');
      }

      updateTimer();
      const timerInterval = setInterval(updateTimer, 1000);

      document.addEventListener('shopify:section:load', function(e) {
        if (e.detail.sectionId === sectionId) {
          clearInterval(timerInterval);
          updateTimer();
          setInterval(updateTimer, 1000);
        }
      });
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Holiday Timer Banner",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "main_title",
      "label": "Main Title",
      "default": "<p>EXTENDED! BLACK FRIDAY SALE!</p>"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Subtext",
      "default": "<p>86% Off Starter Kit + FREE Creamer + FREE Week of Coffee!</p>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Additional Text (Optional)"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Timer Settings"
    },
    {
      "type": "checkbox",
      "id": "show_timer",
      "label": "Show Countdown Timer",
      "default": true
    },
    {
      "type": "range",
      "id": "min_hours",
      "min": 1,
      "max": 12,
      "step": 0.5,
      "unit": "hrs",
      "label": "Minimum Hours",
      "default": 3
    },
    {
      "type": "range",
      "id": "max_hours",
      "min": 1,
      "max": 24,
      "step": 0.5,
      "unit": "hrs",
      "label": "Maximum Hours",
      "default": 8
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "gradient_start",
      "label": "Gradient Start Color",
      "default": "#1E6C7A"
    },
    {
      "type": "color",
      "id": "gradient_end",
      "label": "Gradient End Color",
      "default": "#E6E0FA"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 10
    }
  ],
  "presets": [
    {
      "name": "Holiday Timer Banner",
      "category": "CWC Custom"
    }
  ]
}
{% endschema %}
