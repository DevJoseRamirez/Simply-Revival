{% doc %}
  @prompt
    simple blocks displaying all our our store policies by default with optoins selectoin of menu selection to diplsay those if selectec just store colors black text white backgrouhnd, just the policy / menu links - NOT the full poilicy content, ok great policy potition can lock that in keep it - now to the right of the policy links add a copywritng symbom 2024 {store name}
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-policy-links-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding }}px 20px;
  }

  .ai-policy-links__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-policy-links__heading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 {{ block.settings.spacing }}px 0;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-policy-links__wrapper-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 30px;
  }

  .ai-policy-links__list-{{ ai_gen_id }} {
    display: flex;
    flex-direction: {{ block.settings.layout }};
    gap: {{ block.settings.link_spacing }}px;
    list-style: none;
    padding: 0;
    margin: 0;
    justify-content: {{ block.settings.text_alignment }};
    flex-wrap: wrap;
  }

  .ai-policy-links__item-{{ ai_gen_id }} {
    margin: 0;
  }

  .ai-policy-links__link-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.link_size }}px;
    text-decoration: {{ block.settings.link_style }};
    transition: opacity 0.2s ease;
  }

  .ai-policy-links__link-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-policy-links__separator-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    opacity: 0.5;
  }

  .ai-policy-links__copyright-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.link_size }}px;
    white-space: nowrap;
  }

  .ai-policy-links__empty-{{ ai_gen_id }} {
    color: #999999;
    font-size: 14px;
    text-align: center;
    padding: 20px;
    font-style: italic;
  }

  @media screen and (max-width: 749px) {
    .ai-policy-links-{{ ai_gen_id }} {
      padding: {{ block.settings.padding | times: 0.7 }}px 16px;
    }

    .ai-policy-links__wrapper-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 15px;
    }

    .ai-policy-links__list-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: center;
    }

    .ai-policy-links__separator-{{ ai_gen_id }} {
      display: none;
    }

    .ai-policy-links__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-policy-links-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-policy-links__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-policy-links__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    {% liquid
      assign policy_links = ''
      assign link_count = 0
      
      if block.settings.show_refund_policy and shop.refund_policy != blank
        assign link_count = link_count | plus: 1
      endif
      
      if block.settings.show_privacy_policy and shop.privacy_policy != blank
        assign link_count = link_count | plus: 1
      endif
      
      if block.settings.show_terms_of_service and shop.terms_of_service != blank
        assign link_count = link_count | plus: 1
      endif
      
      if block.settings.show_shipping_policy and shop.shipping_policy != blank
        assign link_count = link_count | plus: 1
      endif
    %}

    {% if link_count > 0 %}
      <div class="ai-policy-links__wrapper-{{ ai_gen_id }}">
        <ul class="ai-policy-links__list-{{ ai_gen_id }}">
          {% assign current_link = 0 %}
          
          {% if block.settings.show_refund_policy and shop.refund_policy != blank %}
            {% assign current_link = current_link | plus: 1 %}
            <li class="ai-policy-links__item-{{ ai_gen_id }}">
              <a href="{{ shop.refund_policy.url }}" class="ai-policy-links__link-{{ ai_gen_id }}">
                {{ shop.refund_policy.title }}
              </a>
            </li>
            {% if current_link < link_count and block.settings.show_separator %}
              <li class="ai-policy-links__separator-{{ ai_gen_id }}" aria-hidden="true">{{ block.settings.separator_text }}</li>
            {% endif %}
          {% endif %}

          {% if block.settings.show_privacy_policy and shop.privacy_policy != blank %}
            {% assign current_link = current_link | plus: 1 %}
            <li class="ai-policy-links__item-{{ ai_gen_id }}">
              <a href="{{ shop.privacy_policy.url }}" class="ai-policy-links__link-{{ ai_gen_id }}">
                {{ shop.privacy_policy.title }}
              </a>
            </li>
            {% if current_link < link_count and block.settings.show_separator %}
              <li class="ai-policy-links__separator-{{ ai_gen_id }}" aria-hidden="true">{{ block.settings.separator_text }}</li>
            {% endif %}
          {% endif %}

          {% if block.settings.show_terms_of_service and shop.terms_of_service != blank %}
            {% assign current_link = current_link | plus: 1 %}
            <li class="ai-policy-links__item-{{ ai_gen_id }}">
              <a href="{{ shop.terms_of_service.url }}" class="ai-policy-links__link-{{ ai_gen_id }}">
                {{ shop.terms_of_service.title }}
              </a>
            </li>
            {% if current_link < link_count and block.settings.show_separator %}
              <li class="ai-policy-links__separator-{{ ai_gen_id }}" aria-hidden="true">{{ block.settings.separator_text }}</li>
            {% endif %}
          {% endif %}

          {% if block.settings.show_shipping_policy and shop.shipping_policy != blank %}
            <li class="ai-policy-links__item-{{ ai_gen_id }}">
              <a href="{{ shop.shipping_policy.url }}" class="ai-policy-links__link-{{ ai_gen_id }}">
                {{ shop.shipping_policy.title }}
              </a>
            </li>
          {% endif %}
        </ul>

        <div class="ai-policy-links__copyright-{{ ai_gen_id }}">
          &copy; 2024 {{ shop.name }}
        </div>
      </div>
    {% else %}
      <div class="ai-policy-links__empty-{{ ai_gen_id }}">
        No policies selected or available. Configure your store policies in Settings > Policies.
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Policy links",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "checkbox",
      "id": "show_refund_policy",
      "label": "Show refund policy",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_privacy_policy",
      "label": "Show privacy policy",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_terms_of_service",
      "label": "Show terms of service",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_shipping_policy",
      "label": "Show shipping policy",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "row",
          "label": "Horizontal"
        },
        {
          "value": "column",
          "label": "Vertical"
        }
      ],
      "default": "row"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "show_separator",
      "label": "Show separator between links",
      "default": true
    },
    {
      "type": "text",
      "id": "separator_text",
      "label": "Separator text",
      "default": "|"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "link_style",
      "label": "Link style",
      "options": [
        {
          "value": "none",
          "label": "No underline"
        },
        {
          "value": "underline",
          "label": "Underline"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "link_size",
      "label": "Link size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "link_spacing",
      "label": "Space between links",
      "min": 5,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Space below heading",
      "min": 5,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Vertical padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 600,
      "max": 1400,
      "step": 100,
      "unit": "px",
      "default": 1000
    }
  ],
  "presets": [
    {
      "name": "Policy links"
    }
  ]
}
{% endschema %}
