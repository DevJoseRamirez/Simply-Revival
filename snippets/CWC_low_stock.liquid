{% comment %}
  CWC Low Stock Notice

  Only renders when the product is reading REAL inventory:
  - at least one variant has inventory tracking enabled, and
  - the total tracked quantity is above 0 and at or below the threshold.

  If inventory isn't tracked (quantity is unreliable / always 0), or stock is
  above the threshold, or the product is sold out, nothing is output.

  Accepts:
  - block   {Object} The low_stock block
  - product {Object} The product to read inventory from
{% endcomment %}

{%- liquid
  assign cwc_low_stock_threshold = block.settings.inventory_threshold
  if cwc_low_stock_threshold == blank
    assign cwc_low_stock_threshold = 1000
  endif

  assign cwc_low_stock_tracked = false
  assign cwc_low_stock_qty = 0

  for cwc_low_stock_variant in product.variants
    if cwc_low_stock_variant.inventory_management != blank
      assign cwc_low_stock_tracked = true
      assign cwc_low_stock_qty = cwc_low_stock_qty | plus: cwc_low_stock_variant.inventory_quantity
    endif
  endfor

  assign cwc_low_stock_show = false
  if cwc_low_stock_tracked and cwc_low_stock_qty > 0 and cwc_low_stock_qty <= cwc_low_stock_threshold
    assign cwc_low_stock_show = true
  endif
-%}

{%- if cwc_low_stock_show -%}
  {% style %}
    .cwc-low-stock--{{ block.id }} {
      --text-primary-color: {{ block.settings.text_primary_color | default: '#7B2D3E' }};
      --text-secondary-color: {{ block.settings.text_secondary_color | default: '#7B2D3E' }};
      --line-color: {{ block.settings.line_color | default: '#7B2D3E' }};
      --padding-top: {{ block.settings.padding_top | default: 8 }}px;
      --padding-bottom: {{ block.settings.padding_bottom | default: 8 }}px;
    }
  {% endstyle %}

  {% style %}
    .cwc-low-stock {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding-top: var(--padding-top);
      padding-bottom: var(--padding-bottom);
      width: 100%;
    }

    .cwc-low-stock::before,
    .cwc-low-stock::after {
      content: '';
      flex-grow: 1;
      height: 1px;
      background-color: var(--line-color, #7b2d3e);
      /* opacity: 0.5; */
      /* opacity: 1s; */
    }

    .cwc-low-stock__text {
      white-space: nowrap;
      font-size: 0.875rem;
      font-weight: 500;
      letter-spacing: 0.01em;
    }

    .cwc-low-stock__text-primary {
      color: var(--text-primary-color, #7b2d3e);
    }

    .cwc-low-stock__text-secondary {
      color: var(--text-secondary-color, #7b2d3e);
    }

    .cwc-low-stock__divider {
      color: var(--text-primary-color, #7b2d3e);
    }
  {% endstyle %}

  <div class="cwc-low-stock cwc-low-stock--{{ block.id }}">
    {% if block.settings.text_primary != blank or block.settings.text_secondary != blank %}
      <span class="cwc-low-stock__text">
        {% if block.settings.text_primary != blank %}
          <span class="cwc-low-stock__text-primary">{{ block.settings.text_primary }}</span>
        {% endif %}
        {% if block.settings.text_primary != blank and block.settings.text_secondary != blank %}
          <span class="cwc-low-stock__divider"> – </span>
        {% endif %}
        {% if block.settings.text_secondary != blank %}
          <span class="cwc-low-stock__text-secondary">{{ block.settings.text_secondary }}</span>
        {% endif %}
      </span>
    {% endif %}
  </div>
{%- endif -%}
