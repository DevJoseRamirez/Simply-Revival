{% style %}
  .cwc-bundle-product-template__content {
  margin-bottom: 1.5rem;

  /* Inject dynamic colors */
  --title-color: {{ block.settings.title_color }};
  --text-color: {{ block.settings.text_color }};
  }

  .cwc-bundle-product-template__content .bundle-content-bottom {
  max-width: 34rem;
  }

  /* Title */
  .cwc-bundle-product-template__content .bundle-content-bottom__title {
  margin-bottom: 0.25rem;
  }

  .cwc-bundle-product-template__content .bundle-content-bottom__title h1,
  .cwc-bundle-product-template__content .bundle-content-bottom__title h2,
  .cwc-bundle-product-template__content .bundle-content-bottom__title h3,
  .cwc-bundle-product-template__content .bundle-content-bottom__title h4,
  .cwc-bundle-product-template__content .bundle-content-bottom__title p {
  margin: 0;
  /* font-weight: 800; */
  /* font-weight: 800; */
  text-transform: uppercase;
  letter-spacing: 0.02em;
  color: var(--title-color);
  font-weight: 700;
  font-size: 2em;
  font-size: 1.4rem;
  font-size: 1.4rem;
  line-height: normal;
  }

  /* Main bold text */
  .cwc-bundle-product-template__content .bundle-content-bottom__text {
  margin-bottom: 0.25rem;
  margin-bottom: 0rem;
  }

  .cwc-bundle-product-template__content .bundle-content-bottom__text > * {
  font-weight: 600;
  }


  .cwc-bundle-product-template__content .bundle-content-bottom__text p {
  margin: 0;
  font-size: 1.25rem;
  font-weight: 600;
  line-height: 1.4;
  color: var(--text-color);
  font-size: 1rem;
  font-size: 1.2rem;

  /* line-height: normal; */
  }

  /* Subtext */
  .cwc-bundle-product-template__content .bundle-content-bottom__subtext p {
  margin: 0;
  font-size: 1.25rem;
  line-height: 1.4;
  /* line-height: normal; */
  color: var(--text-color);
  font-size: 1rem;
  font-size: 1.05rem;
  margin-bottom: .5rem;
  margin-bottom: 1rem;
  }


  .bundle-content-bottom__prod_title {
  margin-bottom: .8rem;

  }
  .bundle-content-bottom__prod_title > *{
  /* font-weight: 700; */
  font-size: 2.8125rem;
  line-height: normal



  }

  .bundle-content-bottom__text>* {
  font-weight: 700;
  font-size: 1.05rem;
  line-height: normal;
  line-height: 135%;
  }

  .bundle-content-bottom__subtext {
  font-size: 1.05rem;
  margin-bottom: 1rem;
  }

  .bundle-content-bottom__subtext >*{
  font-size: 1.05rem;
  line-height: normal;
  line-height: 135%;
    }

  @media (max-width: 991px) {



  }
{% endstyle %}

<div class="bundle-content-bottom" {{ block.shopify_attributes }}>
  {% if block.settings.text != blank %}
    <div class="bundle-content-bottom__text">
      {{ block.settings.text }}
    </div>
  {% endif %}

  {% if block.settings.subtext != blank %}
    <div class="bundle-content-bottom__subtext">
      {{ block.settings.subtext }}
    </div>
  {% endif %}
</div>
