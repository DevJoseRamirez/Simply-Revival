{% style %}
  .cwc-featured-product__benefits {
    display: flex;
    flex-wrap: wrap;
    /* gap: 0.75rem; */

    display: flex;
    flex-wrap: wrap;
    background: #fbfbfb;
    /* background: #ac3939ff; */
    border-radius: 5.65px;
    padding: 20px 17px 6px;
    margin-bottom: 27px;

    column-gap: 1rem;
    padding: 1rem 1rem 0.5rem 1rem;
  }

  .cwc-featured-product__benefit {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0rem 0rem 0.5rem 0rem;
    /* background: #f8f9fa; */
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 500;
    color: #125657;
    width: 30%;
    width: 45%;
    width: 100%;
  }
  .cwc-featured-product__benefit img {
    width: 20px;
    height: 20px;
    object-fit: contain;
  }

  @media (max-width: 768px) {
    .cwc-featured-product__benefits {
      gap: 0.5rem;
    }
    .cwc-featured-product__benefit {
      width: 45%;
      width: 100%;
    }
    .cwc-featured-product__benefit {
      font-size: 0.85rem;
      padding: 0.4rem 0.6rem;
    }
  }
{% endstyle %}

{% for i in (1..6) %}
  {% assign icon_key = 'icon' | append: i %}
  {% assign text_key = 'text' | append: i %}
  {% if block.settings[icon_key] != blank or block.settings[text_key] != blank %}
    <div class="cwc-featured-product__benefit">
      {% if block.settings[icon_key] != blank %}
        <img
          src="{{ block.settings[icon_key] | image_url: width: 24 }}"
          alt="{{ block.settings[icon_key].alt }}"
        >
      {% endif %}
      <span class="cwc-featured-product__benefit-text">{{ block.settings[text_key] }}</span>
    </div>
  {% endif %}
{% endfor %}
