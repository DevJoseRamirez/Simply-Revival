{% style %}
  .cwc-bundle-product-template__refund-bar {
    /* margin: 1rem 0 1.25rem; */
    margin: 1rem 0rem;
    max-width: 40rem;
  }

  .cwc-bundle-product-template__refund-bar-text {
    font-size: 0.95rem;
    font-size: 0.85rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: #111827;
    margin-bottom: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    text-align: center;
    width: 100%;
    justify-content: center;
  }

  .cwc-bundle-product-template__refund-bar-track {
    width: 100%;
    height: 8px;
    border-radius: 9999px;
    background: var(--bar-bg, #e5e7eb);
    overflow: hidden;
    background-color: #ddd;
  }

  .cwc-bundle-product-template__refund-bar-fill {
    height: 100%;
    width: var(--bar-fill, 50%);
    background: var(--bar-color, #ef4444);
    border-radius: 9999px;
    transition: width 0.4s ease;
  }
{% endstyle %}

{% if block.settings.text != blank %}
  <div class="cwc-bundle-product-template__refund-bar-text">
    {{ block.settings.text }}
  </div>
{% endif %}

<div
  class="cwc-bundle-product-template__refund-bar-track"
  style="         --bar-bg: {{ block.settings.bg_color }};"
>
  <div
    class="cwc-bundle-product-template__refund-bar-fill"
    style="
      --bar-color: {{ block.settings.bar_color }};
      --bar-fill: {{ block.settings.progress | default: 50 }}%;
    "
  ></div>
</div>
