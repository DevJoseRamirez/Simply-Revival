{% style %}
      .cwc_product-template__add_to_cart,
      .cwc-bundle-product-template__add_to_cart__add_to_cart{}


      .cwc-bundle-product-template__add_to_cart__button {
      padding: 1rem 2rem;
      font-weight: 700;
      font-size: 1.058rem;
      border-radius: 6px;
      border: 2px solid transparent;
      text-decoration: none;
      transition: all 0.3s ease-in-out;
      text-align: center;
      text-transform: uppercase;
      text-transform: capitalize;

      font-weight: 400;
      cursor: pointer;
      width: 100%;
      background-color: {{ block.settings.button_bg_color }};
      color: {{ block.settings.button_text_color }};
      -webkit-tap-highlight-color: transparent;

    /* testing */
          max-width: 336px;
              font-size: 1rem;
      font-weight: 600;
      padding: .8rem 1.5rem;
      border: 2px solid transparent;
      border-radius: 6px;
      text-decoration: none;
      text-align: center;
      transition: all .3s
  ease-in-out;
      display: inline-block;
      max-width: 336px;
      width: 100%;

          background: linear-gradient(90deg, #D0F0E8 0%, #E6E0FA 29%, #E3F6F9 40%, #F7EEC5 70%, #D0F0E8 100%);
          border-color: black;
          color: black;
      }

      .cwc-bundle-product-template__add_to_cart__button:hover {
      /* border-color: {{ block.settings.button_bg_color }}; */
      /* background-color: {{ block.settings.button_text_color }}; */
      /* color: {{ block.settings.button_bg_color }}; */
      /* opacity: .9; */
      /* background-color: transparent; */
      transition: all 0.3s ease-in-out;
      background: transparent;
          background: linear-gradient(-90deg, #D0F0E8 0%, #E6E0FA 29%, #E3F6F9 40%, #F7EEC5 70%, #D0F0E8 100%);
      }


      .cwc-bundle-product-template__add_to_cart__button:active {
      outline: none;
      -webkit-tap-highlight-color: transparent;
      box-shadow: none;
      }


      .cwc-bundle-product-template__add_to_cart__button:disabled {
      opacity: 0.6;
      cursor: not-allowed;
      }

      .cwc-bundle-product-template__add_to_cart__button .cwc-bundle-product-template__add_to_cart__price-current {
      }

      .cwc-bundle-product-template__add_to_cart__button .cwc-bundle-product-template__add_to_cart__price-current {
      font-size: inherit;
      color: inherit;
      }

      .cwc-bundle-product-template__add_to_cart__button .cwc-bundle-product-template__add_to_cart__price-compare {
      opacity: 0.6;
      color: inherit;
      font-size: inherit;
      }

      .cwc-bundle-product-template__add_to_cart__button .cwc-bundle-product-template__add_to_cart__price-save {
      display: none;

      }
      .cwc-bundle-product-template__add_to_cart__add_to_cart-content {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      }
      .cwc-button-text {
      font-weight: 700;
          text-transform: uppercase;
        letter-spacing: 1px;
      }

      @media (max-width: 991px) {

      .cwc-bundle-product-template__add_to_cart__button {
      border-radius: 4px;
      font-size: 0.9375rem;
      line-height: 16px;
      height: 56px;
      width: 100%;
      max-width: none;
      }
      }
      @media (max-width: 768px) {
      }
{% endstyle %}

{% assign main_product = product %}

{% liquid
  assign bundle_product_1 = block.settings.bundle_product_1
  assign bundle_product_2 = block.settings.bundle_product_2
  assign bundle_product_3 = block.settings.bundle_product_3
  assign bundle_product_4 = block.settings.bundle_product_4
%}

<button
  type="button"
  class="cwc-bundle-product-template__add_to_cart__button"
  id="add-to-cart-{{ section_id }}"
  {% unless product.available %}
    disabled
  {% endunless %}

  {% comment %} *THIS LIKE HERE {% endcomment %}
  data-skip-cart="{{ block.settings.skip_cart }}"

  {%- if bundle_product_1 != blank -%}
    data-bundle-variant1="{{ bundle_product_1.selected_or_first_available_variant.id }}"
  {%- endif -%}
  {%- if bundle_product_2 != blank -%}
    data-bundle-variant2="{{ bundle_product_2.selected_or_first_available_variant.id }}"
  {%- endif -%}
  {%- if bundle_product_3 != blank -%}
    data-bundle-variant3="{{ bundle_product_3.selected_or_first_available_variant.id }}"
  {%- endif -%}
  {%- if bundle_product_4 != blank -%}
    data-bundle-variant4="{{ bundle_product_4.selected_or_first_available_variant.id }}"
  {%- endif -%}
>
  <div class="cwc-bundle-product-template__add_to_cart__add_to_cart-content">
    {% if product.available %}
      <span class="cwc-button-text"> {{ block.settings.button_text | default: 'Add Bundle to Cart' }}</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="10" height="8" viewBox="0 0 10 8" fill="none">
        <path d="M9.35355 4.03568C9.54882 3.84042 9.54882 3.52384 9.35355 3.32858L6.17157 0.146595C5.97631 -0.0486671 5.65973 -0.0486671 5.46447 0.146595C5.2692 0.341857 5.2692 0.65844 5.46447 0.853702L8.29289 3.68213L5.46447 6.51056C5.2692 6.70582 5.2692 7.0224 5.46447 7.21766C5.65973 7.41292 5.97631 7.41292 6.17157 7.21766L9.35355 4.03568ZM0 3.68213V4.18213H9V3.68213V3.18213H0V3.68213Z" fill="black"/>
      </svg>
    {% else %}
      <span class="cwc-button-text">Sold Out</span>
    {% endif %}
  </div>
</button>
