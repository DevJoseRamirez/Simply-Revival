{% style %}
  .cwc-bundle-product-template__content {
    margin-bottom: 1.5rem;

    /* Inject dynamic colors */
    --title-color: {{ block.settings.title_color }};
    --text-color: {{ block.settings.text_color }};
  }

  .cwc-bundle-product-template__content .bundle-content {
    max-width: 34rem;
  }

  /* Title */
  .cwc-bundle-product-template__content .bundle-content__title {
    margin-bottom: 0.25rem;
  }

  .cwc-bundle-product-template__content .bundle-content__title h1,
  .cwc-bundle-product-template__content .bundle-content__title h2,
  .cwc-bundle-product-template__content .bundle-content__title h3,
  .cwc-bundle-product-template__content .bundle-content__title h4,
  .cwc-bundle-product-template__content .bundle-content__title p {
    margin: 0;
    /* font-weight: 800; */
    /* font-weight: 800; */
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--title-color);
    font-size: 2em;
  }

  /* Main bold text */
  .cwc-bundle-product-template__content .bundle-content__text {
    margin-bottom: 0.25rem;
  }

  .cwc-bundle-product-template__content .bundle-content__text p {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.4;
    color: var(--text-color);
  }

  /* Subtext */
  .cwc-bundle-product-template__content .bundle-content__subtext p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--text-color);
  }
{% endstyle %}

{% if block.settings.title != blank or block.settings.text != blank or block.settings.subtext != blank %}
  <div class="bundle-content" {{ block.shopify_attributes }}>
    {% if block.settings.title != blank %}
      <div class="bundle-content__title rte">
        {{ block.settings.title }}
      </div>
    {% endif %}

    {% if block.settings.prod_title != blank %}
      <div class="bundle-content__prod_title rte">
        {{ block.settings.prod_title }}
      </div>
    {% endif %}

    {% if block.settings.text != blank %}
      <div class="bundle-content__text rte">
        {{ block.settings.text }}
      </div>
    {% endif %}

    {% if block.settings.subtext != blank %}
      <div class="bundle-content__subtext rte">
        {{ block.settings.subtext }}
      </div>
    {% endif %}
  </div>
{% endif %}
