{% style %}
  /* ================================
     Price Display
     ================================ */

  .cwc_product-template__price,
  .cwc-featured-product__price {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    margin: 0rem 0 1rem 0;
    border-top: 0.55px solid rgba(0, 0, 0, 0.2);
    border-bottom: 0.55px solid rgba(0, 0, 0, 0.2);
    font-size: 1.3125rem;
    width: 100%;
    gap: 3rem;
    padding: 0.74rem 0rem;
    padding: 0.7rem 0rem;
  }

  .cwc-featured-product__price-current {
    font-weight: 700;
    color: #60a1a2;
    font-size: 1.25rem;
  }

  .cwc-featured-product__price-compare {
    font-size: 1.25rem;
    /* font-size: inherit; */
    font-weight: 400;
    color: #08122a;
    text-decoration: line-through;
    /*  */
    opacity: 0.7;
  }

  .cwc-featured-product__price-save {
    font-size: inherit;
    display: flex;
    font-size: 0.9rem;
    font-weight: 600;
    color: #fff;
    padding: 0.13rem 0.95rem;
    background: #60a1a2;
    border-radius: 5px;
    gap: 8px;
  }
  .cwc-featured-product__price-save span {
    font-size: inherit;
    font-size: 0.9rem;
  }
  @media (max-width: 991px) {
    .cwc-featured-product__price-current,
    .cwc-featured-product__price-compare {
      font-size: 1.125rem;
    }
    .cwc-featured-product__price-save span {
      font-size: 0.86rem;
    }
    .cwc_product-template__price,
    .cwc-featured-product__price {
      gap: 2rem;
    }
  }
  /* ================================
   Mobile Responsive (max-width: 768px)
   ================================ */
  @media (max-width: 768px) {
    .cwc_product-template__price,
    .cwc-featured-product__price {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      margin: 0rem 0 1rem 0;
      border-top: 0.55px solid rgba(0, 0, 0, 0.2);
      border-bottom: 0.55px solid rgba(0, 0, 0, 0.2);
      font-size: 1.3125rem;
      width: 100%;
      padding: 0.5rem 0rem;
      gap: 1rem;
      font-size: 1.3125rem;
    }
    .cwc-featured-product__price-save {
      line-height: normal;
      font-size: 0.86rem;
    }
  }
{% endstyle %}

{% comment %}
  =====================================================
  PRICE DISPLAY
  =====================================================
  Uses default_variant passed from section for initial display.
  JS will update these elements when variant/subscription changes.

  PRICING LOGIC:
  - compare_price: ALWAYS variant.compare_at_price (strikeout price)
  - display_price: subscription price if available, else variant.price
  - savings: compare_price - display_price
  =====================================================
{% endcomment %}

{% liquid
  assign variant = default_variant | default: product.selected_or_first_available_variant

  assign compare_price = variant.compare_at_price
  assign display_price = variant.price

  comment
    If variant has subscription and checkbox is checked by default,
    use the subscription price for display (but keep compare as variant.compare_at_price)
  endcomment
  if variant.selling_plan_allocations.size > 0
    assign allocation = variant.selling_plan_allocations[0]
    assign display_price = allocation.price
  endif
%}

<span class="cwc-featured-product__price-current" id="current-price-{{ section_id }}">
  {{ display_price | money }}
</span>

{% if compare_price and compare_price > display_price %}
  <span class="cwc-featured-product__price-compare" id="compare-price-{{ section_id }}">
    {{ compare_price | money }}
  </span>
  <div class="cwc-featured-product__price-save" id="save-amount-{{ section_id }}">
    <span>Save</span>
    <span>
      {{ compare_price | minus: display_price | money }}
    </span>
  </div>
{% endif %}
