{% style %}
  /* ================================
   Price Display
   ================================ */

  .cwc-featured-product__price {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 1rem;
    margin: 0rem 0 1rem 0;
    border-top: 0.55px solid rgba(0, 0, 0, 0.2);
    border-bottom: 0.55px solid rgba(0, 0, 0, 0.2);
    font-size: 1.4rem;
    font-size: 1.3125rem;
    width: 100%;
    gap: 3.3rem;
    padding: 0.76rem 0rem;
  }

  .cwc-featured-product__price-current {
    font-size: 2rem;
    font-size: inherit;
    font-weight: 700;
    color: #60a1a2;
  }

  .cwc-featured-product__price-compare {
    font-size: 1.25rem;
    font-size: inherit;
    font-weight: 400;
    color: #08122a;
    text-decoration: line-through;
  }

  .cwc-featured-product__price-save {
    font-size: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    color: #fff;
    padding: 0.15rem 0.6rem;
    background: #60a1a2;
    border-radius: 4px;
  }
{% endstyle %}

<span class="cwc-featured-product__price-current" id="current-price-{{ section_id }}">
  {{ product.price | money }}
</span>
{% if product.compare_at_price > product.price %}
  <span class="cwc-featured-product__price-compare" id="compare-price-{{ section_id }}">
    {{ product.compare_at_price | money }}
  </span>
  <span class="cwc-featured-product__price-save" id="save-amount-{{ section_id }}">
    <span> Save </span>
    {{ product.compare_at_price | minus: product.price | money }}
  </span>
{% endif %}
