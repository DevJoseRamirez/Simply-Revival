{% comment %}
  cwc-featured-product__options with custom block images
{% endcomment %}
{% style %}
  #CWC_featured-product__options-{{ block.id }} {
    {% if block.settings.badge_text_1 != blank %}--badge_text-1: "{{ block.settings.badge_text_1 | escape }}";{% endif %}
    {% if block.settings.badge_text_2 != blank %}--badge_text-2: "{{ block.settings.badge_text_2 | escape }}";{% endif %}
    {% if block.settings.badge_text_3 != blank %}--badge_text-3: "{{ block.settings.badge_text_3 | escape }}";{% endif %}
  }
{% endstyle %}

{{ 'CWC_product_options.css' | asset_url | stylesheet_tag }}

{% comment %}
  Use default_variant passed from section if available,
  otherwise fall back to selected_or_first_available_variant
{% endcomment %}
{% if default_variant %}
  {% assign sel = default_variant %}
{% else %}
  {% assign sel = product.selected_or_first_available_variant %}
{% endif %}

{% for option in product.options_with_values %}
  <div class="cwc-featured-product__option">
    {% comment %} <label class="cwc-option-label">{{ option.name }}</label> {% endcomment %}

    <div class="cwc-featured-product__option_buttons">
      {% comment %} <div class="cwc-option-buttons"> {% endcomment %}
      {% for value in option.values %}
        {%- comment -%}
          Candidate variant for this button:
          - Set this option to "value"
          - Keep other options set to the current selection (sel)
        {%- endcomment -%}
        {% assign candidate = null %}
        {% for v in product.variants %}
          {% assign match = true %}
          {% if option.position == 1 %}
            {% if v.option1 != value %}{% assign match = false %}{% endif %}
            {% if product.options.size > 1 and v.option2 != sel.option2 %}{% assign match = false %}{% endif %}
            {% if product.options.size > 2 and v.option3 != sel.option3 %}{% assign match = false %}{% endif %}
          {% elsif option.position == 2 %}
            {% if v.option2 != value %}{% assign match = false %}{% endif %}
            {% if v.option1 != sel.option1 %}{% assign match = false %}{% endif %}
            {% if product.options.size > 2 and v.option3 != sel.option3 %}{% assign match = false %}{% endif %}
          {% else %}
            {% if v.option3 != value %}{% assign match = false %}{% endif %}
            {% if v.option1 != sel.option1 %}{% assign match = false %}{% endif %}
            {% if v.option2 != sel.option2 %}{% assign match = false %}{% endif %}
          {% endif %}
          {% if match -%}
            {%- assign candidate = v -%}
            {%- break -%}
          {%- endif %}
        {% endfor %}

        {%- assign is_selected = false -%}
        {% if option.position == 1 and sel.option1 == value -%}
          {%- assign is_selected = true %}
        {% elsif option.position == 2 and sel.option2 == value -%}
          {%- assign is_selected = true %}
        {% elsif option.position == 3 and sel.option3 == value -%}
          {%- assign is_selected = true %}
        {% endif %}

        {%- comment -%}
          =====================================================
          PRICE / SAVINGS CALCULATION
          =====================================================
          Since subscription toggle is ON by default:
          - display_price: subscription_price (or candidate.price if no subscription)
          - compare_price: ALWAYS candidate.compare_at_price
          =====================================================
        {%- endcomment -%}
        {% assign show_compare = false %}
        {% assign save_money = 0 %}
        {% assign save_pct = 0 %}
        {% assign display_price = candidate.price %}

        {%- comment -%}
          =====================================================
          SELLING PLAN DATA (Variant-level subscriptions)
          =====================================================
          selling_plan_allocation object has:
          - .price = discounted price (pre-calculated)
          - .compare_at_price = compare price for subscription
          - .selling_plan.id = the selling plan ID
          =====================================================
        {%- endcomment -%}
        {% assign variant_selling_plan_id = null %}
        {% assign subscription_price = null %}

        {% if candidate and candidate.selling_plan_allocations.size > 0 %}
          {% assign allocation = candidate.selling_plan_allocations[0] %}
          {% assign variant_selling_plan_id = allocation.selling_plan.id %}
          {% assign subscription_price = allocation.price %}

          {% comment %} Subscription is ON by default, so use subscription price as initial display {% endcomment %}
          {% assign display_price = subscription_price %}
        {% endif %}

        {% comment %} Calculate savings: compare_at_price vs display_price {% endcomment %}
        {% if candidate and candidate.compare_at_price and candidate.compare_at_price > display_price %}
          {% assign show_compare = true %}
          {% assign save_money = candidate.compare_at_price | minus: display_price %}
          {% assign save_pct = save_money | times: 100 | divided_by: candidate.compare_at_price %}
        {% endif %}

        {%- comment -%}
          Determine thumbnail URL:
          1. Try custom block images first (based on forloop index)
          2. Fall back to variant featured image
        {%- endcomment -%}
        {%- comment -%} thumbnail url - custom images first, then variant image {%- endcomment -%}
        {% assign thumb_url = null %}
        {% assign option_index = forloop.index0 %}

        {% if option_index == 0 and block.settings.image1 != blank %}
          {% assign thumb_url = block.settings.image1 | image_url: width: 56 %}
        {% elsif option_index == 1 and block.settings.image2 != blank %}
          {% assign thumb_url = block.settings.image2 | image_url: width: 56 %}
        {% elsif option_index == 2 and block.settings.image3 != blank %}
          {% assign thumb_url = block.settings.image3 | image_url: width: 56 %}
        {% elsif candidate and candidate.featured_image %}
          {% assign thumb_url = candidate.featured_image | image_url: width: 56 %}
        {% elsif candidate and candidate.image %}
          {% assign thumb_url = candidate.image | image_url: width: 56 %}
        {% endif %}

        {% comment %} Use custom image if available, otherwise fall back to variant image {% endcomment %}
        {% if custom_image_url %}
          {% assign thumb_url = custom_image_url %}
        {% elsif candidate and candidate.featured_image %}
          {% assign thumb_url = candidate.featured_image | image_url: width: 56 %}
        {% elsif candidate and candidate.image %}
          {% assign thumb_url = candidate.image | image_url: width: 56 %}
        {% endif %}

        {% comment %}
          ======================
           START OF OPTIONS BUTTON
          ======================
        {% endcomment %}

        {% comment %} fot badge here {% endcomment %}
        <div class="cwc-featured-product__option_button__wrap">
          <button
            type="button"
            class="cwc-featured-product__option_button{% if is_selected %} selected{% endif %}{% unless candidate and candidate.available %} disabled{% endunless %}"
            data-option-index="{{ option.position | minus: 1 }}"
            data-option-name="{{ option.name | escape }}"
            data-value="{{ value | escape }}"
            {% if candidate %}
              data-variant-id="{{ candidate.id }}"
              data-price="{{ candidate.price }}"
              data-compare="{{ candidate.compare_at_price | default: 0 }}"
            {% endif %}
            {% comment %} Selling plan data (variant-level subscriptions) {% endcomment %}
            {% if variant_selling_plan_id %}
              data-selling-plan-id="{{ variant_selling_plan_id }}"
            {% endif %}
            {% if subscription_price %}
              data-subscription-price="{{ subscription_price }}"
            {% endif %}
            {% if subscription_compare %}
              data-subscription-compare="{{ subscription_compare }}"
            {% endif %}
            {% if thumb_url %}
              data-thumb="{{ thumb_url }}"
            {% endif %}
            {% unless candidate and candidate.available %}
              disabled aria-disabled="true"
            {% endunless %}
          >
            {% if thumb_url %}
              <span class="cwc-featured-product__option_button_thumb-wrap">
                <img
                  class="cwc-featured-product__option_button_thumb"
                  src="{{ thumb_url }}"
                  alt="{{ candidate.title | escape }}"
                >
              </span>
            {% endif %}

            {%- assign servings_text = blank -%}
            {%- if option_index == 0 -%}
              {%- assign servings_text = block.settings.servings_text_1 -%}
              {%- assign badge_text = block.settings.badge_text_1 -%}
            {%- elsif option_index == 1 -%}
              {%- assign servings_text = block.settings.servings_text_2 -%}
              {%- assign badge_text = block.settings.badge_text_2 -%}
            {%- elsif option_index == 2 -%}
              {%- assign servings_text = block.settings.servings_text_3 -%}
              {%- assign badge_text = block.settings.badge_text_3 -%}
            {%- endif -%}
            <div class="cwc-featured-product__option_button_value_wrap">
              <span class="cwc-featured-product__option_button_value">{{ value }}</span>
              {% comment %} for showing saving in % - script already linked {% endcomment %}

              <span class="cwc-featured-product__option_button_save_perc">You Save {{ save_pct }}%</span>
              {% if block.settings.show_save == true %}
              {% endif %}
              {% comment %} <span class="cwc-featured-product__option_badge_text">{{ badge_text }}</span> {% endcomment %}

              {% if servings_text != blank %}
                <span class="cwc-featured-product__option_button_servings">{{ servings_text }}</span>
              {% endif %}
            </div>

            {% if candidate %}
              <span class="cwc-featured-product__option_button_prices">
                <span class="cwc-featured-product__option_button_price">{{ display_price | money }}</span>
                {% if show_compare %}
                  <span class="cwc-featured-product__option_button_compare_price">
                    {{- candidate.compare_at_price | money -}}
                  </span>
                  {% comment %} <span class="cwc-ob__save">Save {{ save_money | money }} ({{ save_pct }}%)</span> {% endcomment %}
                {% endif %}
              </span>
            {% else %}
              <span class="cwc-featured-product__option_button_prices">
                <span class="cwc-featured-product__option_button_unavalible">Unavailable</span>
              </span>
            {% endif %}

            <span class="cwc-featured-product__option_badge_text-floating">{{ badge_text }}</span>
          </button>
          {% comment %}
            =====================================================
            BONUS ITEMS (displayed below button)
            =====================================================
            Up to 2 bonus items per option (image + text)
          {% endcomment %}
          {% assign bonus_image_1 = null %}
          {% assign bonus_text_1 = null %}
          {% assign bonus_image_2 = null %}
          {% assign bonus_text_2 = null %}

          {% if option_index == 0 %}
            {% assign bonus_image_1 = block.settings.bonus_image_1_opt1 %}
            {% assign bonus_text_1 = block.settings.bonus_text_1_opt1 %}
            {% assign bonus_image_2 = block.settings.bonus_image_2_opt1 %}
            {% assign bonus_text_2 = block.settings.bonus_text_2_opt1 %}
          {% elsif option_index == 1 %}
            {% assign bonus_image_1 = block.settings.bonus_image_1_opt2 %}
            {% assign bonus_text_1 = block.settings.bonus_text_1_opt2 %}
            {% assign bonus_image_2 = block.settings.bonus_image_2_opt2 %}
            {% assign bonus_text_2 = block.settings.bonus_text_2_opt2 %}
          {% elsif option_index == 2 %}
            {% assign bonus_image_1 = block.settings.bonus_image_1_opt3 %}
            {% assign bonus_text_1 = block.settings.bonus_text_1_opt3 %}
            {% assign bonus_image_2 = block.settings.bonus_image_2_opt3 %}
            {% assign bonus_text_2 = block.settings.bonus_text_2_opt3 %}
          {% endif %}

          {% if bonus_text_1 != blank or bonus_text_2 != blank %}
            <div class="cwc-featured-product__option_bonus-items">
              {% if bonus_text_1 != blank %}
                <div class="cwc-featured-product__option_bonus-item">
                  {% if bonus_image_1 != blank %}
                    <img
                      class="cwc-featured-product__option_bonus-icon"
                      src="{{ bonus_image_1 | image_url: width: 40 }}"
                      alt=""
                      width="40"
                      height="40"
                    >
                  {% endif %}
                  <span class="cwc-featured-product__option_bonus-text">{{ bonus_text_1 }}</span>
                </div>
              {% endif %}
              {% if bonus_text_2 != blank %}
                <div class="cwc-featured-product__option_bonus-item">
                  {% if bonus_image_2 != blank %}
                    <img
                      class="cwc-featured-product__option_bonus-icon"
                      src="{{ bonus_image_2 | image_url: width: 40 }}"
                      alt=""
                      width="40"
                      height="40"
                    >
                  {% endif %}
                  <span class="cwc-featured-product__option_bonus-text">{{ bonus_text_2 }}</span>
                </div>
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    <input
      type="hidden"
      name="options[{{ option.name | escape }}]"
      class="cwc-featured-product__option-input"
      data-option-index="{{ option.position | minus: 1 }}"
      value="{% if option.position == 1 %}{{ sel.option1 }}{% elsif option.position == 2 %}{{ sel.option2 }}{% else %}{{ sel.option3 }}{% endif %}"
    >
  </div>
{% endfor %}
