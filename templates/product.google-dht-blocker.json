      "type": "CWC_testimonials",
      "blocks": {
        "testimonial_jcDtAK": {
          "type": "testimonial",
          "settings": {
            "star_rating": "4.8",
            "title": "Finally found something that works!",
            "text": "I've been struggling with hair loss for about 3 years and tried everything. Simply Revival's DHT blocker has been a game changer - I'm seeing new growth after just 2 months of consistent use. The capsules are easy to take and no side effects!",
            "author_name": "MARCUS T.",
            "feature_one": "Hair Growth",
            "feature_two": "Natural Formula"
          }
        },
        "testimonial_rLxFC9": {
          "type": "testimonial",
          "settings": {
            "star_rating": "5.0",
            "title": "My acne cleared up dramatically!",
            "text": "I'm 26 and was dealing with stubborn jawline acne that wouldn't go away. After reading about DHT and hormonal acne, I tried this product. Within 6 weeks my breakouts reduced by like 80%. So glad I found Simply Revival!",
            "author_name": "JESSICA R.",
            "feature_one": "Acne Control",
            "feature_two": "Hormonal Balance"
          }
        },
        "testimonial_zMqLVX": {
          "type": "testimonial",
          "settings": {
            "star_rating": "4.9",
            "title": "Hair shedding stopped completely",
            "text": "Used to lose handfuls of hair in the shower every day. After 3 months on Simply Revival, my hair loss has practically stopped and my hair feels thicker. The natural ingredients give me confidence it's safe for long-term use.",
            "author_name": "DAVID L.",
            "feature_one": "Hair Retention",
            "feature_two": "Clean Ingredients"
          }
        },
        "testimonial_qaxnCw": {
          "type": "testimonial",
          "settings": {
            "star_rating": "4.8",
            "title": "Great value for the price",
            "text": "Compared to other DHT blockers on the market, Simply Revival offers the best bang for your buck. Quality ingredients, effective results, and way more affordable than prescription options. Been using for 4 months now.",
            "author_name": "SARAH M.",
            "feature_one": "Affordable",
            "feature_two": "Effective Formula"
          }
        },
        "testimonial_AkHqfd": {
          "type": "testimonial",
          "settings": {
            "star_rating": "5.0",
            "title": "Nails and hair both improved!",
            "text": "Started taking this primarily for hair thinning but noticed my nails got stronger too! They're growing faster and don't break as easily. Love that Simply Revival covers multiple benefits in one supplement.",
            "author_name": "AMANDA K.",
            "feature_one": "Hair & Nails",
            "feature_two": "Multi-Benefit"
          }
        },
        "testimonial_AxRCrX": {
          "type": "testimonial",
          "settings": {
            "star_rating": "4.8",
            "title": "Easy to incorporate into routine",
            "text": "The capsules are the perfect size and don't have any weird taste or smell. I take them with breakfast every morning and never forget. Consistent use is key and Simply Revival makes it simple to stay on track.",
            "author_name": "TYLER J.",
            "feature_one": "Easy to Take",
            "feature_two": "Daily Wellness"
          }
        },
        "testimonial_8KVzNg": {
          "type": "testimonial",
          "settings": {
            "star_rating": "4.9",
            "title": "Saw results in just 8 weeks",
            "text": "My hairline was starting to recede at 29 which was devastating. Simply Revival helped me regain confidence - I can see baby hairs growing where there was nothing before. Natural approach was important to me and this delivered.",
            "author_name": "RACHEL P.",
            "feature_one": "Quick Results",
            "feature_two": "Confidence Boost"
          }
        },
        "testimonial_dHLeNU": {
          "type": "testimonial",
          "settings": {
            "star_rating": "5.0",
            "title": "Hormonal acne finally under control",
            "text": "Struggled with cystic acne along my jawline for months. Nothing worked until I discovered DHT blockers. Simply Revival has been incredible - my skin is the clearest it's been in years. Highly recommend!",
            "author_name": "KEVIN S.",
            "feature_one": "Cystic Acne",
            "feature_two": "Clear Skin"
          }
        },
        "testimonial_rnMUVE": {
          "type": "testimonial",
          "settings": {
            "star_rating": "4.8",
            "title": "Natural ingredients I can trust",
            "text": "Love that Simply Revival uses clean, natural ingredients without fillers or junk. As someone who's picky about what I put in my body, this product meets all my standards while actually delivering results.",
            "author_name": "MICHELLE W.",
            "feature_one": "Clean Formula",
            "feature_two": "Trustworthy"
