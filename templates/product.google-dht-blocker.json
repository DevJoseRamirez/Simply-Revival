        },
        "testimonial_mCxiU9": {
          "type": "testimonial",
          "settings": {
            "star_rating": "4.8",
            "title": "Perfect for sensitive stomachs",
            "text": "I have a sensitive stomach and many supplements upset me, but Simply Revival is gentle and causes zero digestive issues. I can take it with or without food and feel great. The hair benefits are just a bonus!",
