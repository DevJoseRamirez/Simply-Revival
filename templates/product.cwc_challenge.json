      "blocks": {
        "testimonial_jcDtAK": {
          "type": "testimonial",
          "settings": {
            "star_rating": "4.8",
            "title": "Finally found something that works!",
            "text": "I've been struggling with hair loss for about 3 years and tried everything. Simply Revival's DHT blocker has been a game changer - I'm seeing new growth after just 2 months of consistent use. The capsules are easy to take and no side effects!",
            "author_name": "MARCUS T.",
            "feature_one": "Hair Growth",
            "feature_two": "Natural Formula"
          }
        },
        "testimonial_rLxFC9": {
          "type": "testimonial",
          "settings": {
            "star_rating": "5.0",
            "title": "My acne cleared up dramatically!",
            "text": "I'm 26 and was dealing with stubborn jawline acne that wouldn't go away. After reading about DHT and hormonal acne, I tried this product. Within 6 weeks my breakouts reduced by like 80%. So glad I found Simply Revival!",
            "author_name": "JESSICA R.",
            "feature_one": "Acne Control",
            "feature_two": "Hormonal Balance"
          }
        },
        "testimonial_zMqLVX": {
          "type": "testimonial",
          "settings": {
            "star_rating": "4.9",
            "title": "Hair shedding stopped completely",
            "text": "Used to lose handfuls of hair in the shower every day. After 3 months on Simply Revival, my hair loss has practically stopped and my hair feels thicker. The natural ingredients give me confidence it's safe for long-term use.",
            "author_name": "DAVID L.",
            "feature_one": "Hair Retention",
            "feature_two": "Clean Ingredients"
          }
        },
        "testimonial_qaxnCw": {
          "type": "testimonial",
          "settings": {
            "star_rating": "4.8",
            "title": "Great value for the price",
            "text": "Compared to other DHT blockers on the market, Simply Revival offers the best bang for your buck. Quality ingredients, effective results, and way more affordable than prescription options. Been using for 4 months now.",
            "author_name": "SARAH M.",
            "feature_one": "Affordable",
            "feature_two": "Effective Formula"
          }
        },
        "testimonial_AkHqfd": {
          "type": "testimonial",
          "settings": {
            "star_rating": "5.0",
            "title": "Nails and hair both improved!",
            "text": "Started taking this primarily for hair thinning but noticed my nails got stronger too! They're growing faster and don't break as easily. Love that Simply Revival covers multiple benefits in one supplement.",
            "author_name": "AMANDA K.",
            "feature_one": "Hair & Nails",
            "feature_two": "Multi-Benefit"
