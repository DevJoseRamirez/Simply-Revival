    "cwc_contact_faq_RnrtwJ": {
      "type": "CWC_contact_faq",
      "blocks": {
        "faq_item_gtP6QC": {
          "type": "faq_item",
          "settings": {
            "question": "How do I cancel my subscription?",
            "answer": "<p>We make it easy! You can cancel anytime through <a href=\"https://simplyrevival.com/a/loop_subscriptions/get-subscription-link\" title=\"https://simplyrevival.com/a/loop_subscriptions/get-subscription-link\"><strong>SimplyRevival® Portal</strong></a>, or just drop us a line at <a href=\"mailto:support@simplyrevival.com\" target=\"_blank\"><strong>support@simplyrevival.com</strong></a> and we'll take care of it for you.</p><p>Please include your order number or the email address used at checkout so we can locate your account quickly.</p>",
            "show_badge": false
          }
        },
        "faq_item_8YQ7tX": {
          "type": "faq_item",
          "settings": {
            "question": "Why am I receiving orders I didn't authorize?",
            "answer": "<p>This can happen if an active subscription or saved payment method is still on file. No worries, you can manage or cancel through the <a href=\"https://simplyrevival.com/a/loop_subscriptions/get-subscription-link\" title=\"https://simplyrevival.com/a/loop_subscriptions/get-subscription-link\"><strong>SimplyRevival® Portal</strong></a>, or reach out to <a href=\"mailto:support@simplyrevival.com\" target=\"_blank\"><strong>support@simplyrevival.com</strong></a> and we'll sort it out right away.</p>",
            "show_badge": false
          }
        },
        "faq_item_b9ttLy": {
          "type": "faq_item",
          "settings": {
            "question": "The website says I don't have a subscription, but I'm still being charged?",
            "answer": "<p>It may be linked to a different email or payment method. Try logging into <a href=\"https://simplyrevival.com/a/loop_subscriptions/get-subscription-link\" title=\"https://simplyrevival.com/a/loop_subscriptions/get-subscription-link\"><strong>SimplyRevival® Portal</strong></a> with the email you used at checkout.</p><p>If it's still not showing up, just reach out to <a href=\"mailto:support@simplyrevival.com\" target=\"_blank\"><strong>support@simplyrevival.com</strong></a> and we'll find it for you.</p>",
            "show_badge": false
          }
        },
        "faq_item_kayWeP": {
          "type": "faq_item",
          "settings": {
            "question": "How do I update my subscription (frequency, products, or address)?",
            "answer": "<p>You can update your frequency, products, or shipping address anytime at <a href=\"https://simplyrevival.com/a/loop_subscriptions/get-subscription-link\" title=\"https://simplyrevival.com/a/loop_subscriptions/get-subscription-link\"><strong>SimplyRevival® Portal</strong></a>. Or if you prefer, just email <a href=\"mailto:support@simplyrevival.com\" target=\"_blank\"><strong>support@simplyrevival.com</strong></a> and we'll happily make the changes for you.</p>",
            "show_badge": true
          }
        },
        "faq_item_Fyk3aB": {
          "type": "faq_item",
          "settings": {
            "question": "How do I skip my next shipment?",
            "answer": "<p>Still working through your current supply? No problem! Skip your next shipment at <a href=\"https://simplyrevival.com/a/loop_subscriptions/get-subscription-link\" title=\"https://simplyrevival.com/a/loop_subscriptions/get-subscription-link\"><strong>SimplyRevival® Portal</strong></a>, or let us know at <a href=\"mailto:support@simplyrevival.com\" target=\"_blank\"><strong>support@simplyrevival.com</strong></a> and we'll push your renewal date.</p>",
            "show_badge": true
          }
        }
      },
